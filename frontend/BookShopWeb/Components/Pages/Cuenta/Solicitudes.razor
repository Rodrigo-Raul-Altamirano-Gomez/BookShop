@page "/cuenta/solicitudes"
@layout AccountLayout
@attribute [Authorize(Roles = "CLIENTE")]

<PageTitle>Mis solicitudes · BookShop</PageTitle>

<div class="bk-page-head">
    <div>
        <h1>Mis solicitudes</h1>
        <p class="text-muted small mb-0 mt-1">@(EnReportes ? "Reseñas de otros clientes que reportaste para revisión." : "Devoluciones que pediste de tus pedidos entregados.")</p>
    </div>
</div>
<ul class="nav nav-underline mb-4">
    <li class="nav-item"><a class="nav-link @(EnReportes ? "" : "active")" aria-current="@(EnReportes ? null : "page")" href="cuenta/solicitudes">Devoluciones</a></li>
    <li class="nav-item"><a class="nav-link @(EnReportes ? "active" : "")" aria-current="@(EnReportes ? "page" : null)" href="cuenta/solicitudes?tipo=reportes">Reportes de reseñas</a></li>
</ul>

@if ((EnReportes && reportes == null) || (!EnReportes && solicitudes == null))
{
    <div class="d-grid gap-3" aria-hidden="true">
        @for (int i = 0; i < 2; i++)
        {
            <div class="bk-panel placeholder-glow"><span class="placeholder col-3 mb-2"></span><span class="placeholder col-5 mb-3"></span><span class="placeholder col-10"></span></div>
        }
    </div>
}
else if (EnReportes && reportes!.Count == 0)
{
    <EmptyState Titulo="No has reportado reseñas." Texto="Puedes reportar una reseña desde el detalle de un libro." />
}
else if (EnReportes)
{
    <div class="d-grid gap-3">
        @foreach (ReporteResena reporte in reportes!)
        {
            Libro libro = reporte.Resena.Libro;
            <article class="bk-panel">
                <div class="d-flex align-items-start gap-3">
                    <a href="libros/@libro.Id" class="flex-shrink-0" style="width:2.6rem"><BookCover Libro="libro" Pequena="true" /></a>
                    <div class="flex-grow-1">
                        <h2 class="h3 mb-1">Reseña en <a href="libros/@libro.Id">@libro.Titulo</a></h2>
                        <p class="small text-muted bk-num mb-2">Reportada el @Formato.Fecha(reporte.Fecha) · Motivo: @Etiquetas.Motivo(reporte.Motivo)</p>
                        @* RF10.7: el contenido como estaba al reportarlo *@
                        <blockquote class="bk-quote mb-2">
                            <div class="small"><strong>@reporte.Resena.Usuario.NombreCompleto</strong> <span class="ms-1" role="img" aria-label="@reporte.PuntuacionReportada de 5 estrellas"><RatingStars Promedio="reporte.PuntuacionReportada" /></span></div>
                            <p class="mb-0 mt-1">@reporte.ContenidoReportado</p>
                        </blockquote>
                        <p class="mb-0"><span class="text-muted">Tu comentario:</span> @reporte.Comentario</p>
                    </div>
                    <StatusBadge Texto="@Etiquetas.Estado(reporte.Estado)" Tipo="@Etiquetas.Tipo(reporte.Estado)" />
                </div>
                @if (reporte.Estado == EstadoSolicitud.PENDIENTE)
                {
                    <div class="d-flex gap-3 mt-3 pt-3 border-top" style="border-color:var(--bk-line)!important">
                        <button type="button" class="btn btn-sm btn-link text-decoration-none" @onclick="() => AbrirEdicion(reporte)">Editar</button>
                        <button type="button" class="btn btn-sm btn-link text-decoration-none text-danger" @onclick="() => PedirRetiro(reporte)">Retirar</button>
                    </div>
                }
            </article>
        }
    </div>
}
else if (solicitudes!.Count == 0)
{
    <EmptyState Titulo="No has pedido devoluciones." Texto="Puedes pedirla desde el detalle de un pedido entregado." TextoAccion="Ver mis pedidos" Url="cuenta/pedidos" />
}
else
{
    <div class="d-grid gap-3">
        @foreach (SolicitudDevolucion solicitud in solicitudes)
        {
            <article class="bk-panel">
                <div class="d-flex align-items-start gap-3">
                    <a href="cuenta/pedidos/@solicitud.Pedido.Id" class="flex-shrink-0"><CoverStack Libros="solicitud.Pedido.Detalles.Select(d => d.Libro).ToList()" /></a>
                    <div class="flex-grow-1">
                        <h2 class="h3 mb-1">Pedido <a href="cuenta/pedidos/@solicitud.Pedido.Id">N.º @solicitud.Pedido.Id</a></h2>
                        <p class="small text-muted bk-num mb-2">Solicitada el @Formato.Fecha(solicitud.Fecha) · Motivo: @Etiquetas.Motivo(solicitud.Motivo)</p>
                        <p class="mb-0">@solicitud.Comentario</p>
                    </div>
                    <StatusBadge Texto="@Etiquetas.Estado(solicitud.Estado)" Tipo="@Etiquetas.Tipo(solicitud.Estado)" />
                </div>
                @* RF03.10: solo las pendientes se editan o se retiran *@
                @if (solicitud.Estado == EstadoSolicitud.PENDIENTE)
                {
                    <div class="d-flex gap-3 mt-3 pt-3 border-top" style="border-color:var(--bk-line)!important">
                        <button type="button" class="btn btn-sm btn-link text-decoration-none" @onclick="() => AbrirEdicion(solicitud)">Editar</button>
                        <button type="button" class="btn btn-sm btn-link text-decoration-none text-danger" @onclick="() => PedirRetiro(solicitud)">Retirar</button>
                    </div>
                }
            </article>
        }
    </div>
}

@* Edición de una solicitud o un reporte pendiente: el motivo (con las opciones de su tipo) y el comentario *@
<div class="modal fade" id="m-edit" tabindex="-1" aria-labelledby="m-edit-t" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content p-2" @onsubmit="Guardar">
            <div class="modal-header border-0 pb-0"><h2 class="modal-title h3" id="m-edit-t">@(EnReportes ? "Editar reporte" : "Editar solicitud de devolución")</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
            <div class="modal-body">
                <label class="form-label" for="e-mot">Motivo</label>
                @if (EnReportes)
                {
                    <select class="form-select mb-3" id="e-mot" @bind="motivoReporte">
                        @foreach (MotivoReporte opcion in Enum.GetValues<MotivoReporte>())
                        {
                            <option value="@opcion">@Etiquetas.Motivo(opcion)</option>
                        }
                    </select>
                }
                else
                {
                    <select class="form-select mb-3" id="e-mot" @bind="motivo">
                        @foreach (MotivoDevolucion opcion in Enum.GetValues<MotivoDevolucion>())
                        {
                            <option value="@opcion">@Etiquetas.Motivo(opcion)</option>
                        }
                    </select>
                }
                <label class="form-label" for="e-com">Comentario</label>
                <textarea class="form-control" id="e-com" rows="3" required maxlength="1000" @bind="comentario"></textarea>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" disabled="@guardando">Cancelar</button>
                <button type="submit" class="btn btn-primary" disabled="@guardando">
                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>

<ConfirmModal @ref="confirmacion" TextoAccion="Sí, retirar" Peligro="true" OnConfirmar="Retirar" />
