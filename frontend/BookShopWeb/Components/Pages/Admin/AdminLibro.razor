@page "/admin/libros/nuevo"
@page "/admin/libros/{Id:int}"
@layout AdminLayout
@attribute [Authorize(Roles = "ADMINISTRADOR")]

<PageTitle>@(Id == null ? "Nuevo libro" : libro?.Titulo ?? "Libro") · Administración · BookShop</PageTitle>

<nav aria-label="Ruta">
    <ol class="breadcrumb bk-breadcrumb mb-2">
        <li class="breadcrumb-item"><a href="admin/libros">Libros</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(Id == null ? "Nuevo libro" : libro?.Titulo)</li>
    </ol>
</nav>

@if (noEncontrado)
{
    <EmptyState Titulo="No encontramos este libro." TextoAccion="Volver a Libros" Url="admin/libros" />
}
else if (Id != null && libro == null)
{
    <div class="placeholder-glow" aria-hidden="true">
        <span class="placeholder placeholder-lg col-5 mb-4"></span>
        <div class="row g-4"><div class="col-3"><div class="bk-cover placeholder w-100"></div></div><div class="col-9"><span class="placeholder col-12" style="height:12rem"></span></div></div>
    </div>
}
else if (libro != null && !editando)
{
    @* Consulta (UX-UI §10.3) *@
    <div class="bk-page-head">
        <div>
            <h1 class="mb-1">@libro.Titulo</h1>
            <div class="d-flex align-items-center gap-2"><span class="small text-muted">@libro.Autor.Nombre</span><StatusBadge Texto="@(libro.Activo ? "Activo" : "Inactivo")" Tipo="@(libro.Activo ? "ok" : "neutral")" /></div>
        </div>
        <div class="d-flex gap-2">
            @if (libro.Activo)
            {
                <button type="button" class="btn btn-outline-danger" @onclick="PedirCambioEstado">Desactivar</button>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="PedirCambioEstado">Activar</button>
            }
            <button type="button" class="btn btn-primary" @onclick="Editar"><i class="bi bi-pencil me-2"></i>Editar libro</button>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-3"><div class="bk-panel"><BookCover Libro="libro" /></div></div>
        <div class="col-9 d-grid gap-4">
            <section class="bk-panel">
                <h2 class="h3 mb-3">Datos</h2>
                <dl class="bk-kv row g-3 mb-0">
                    <div class="col-8"><dt>Título</dt><dd class="mb-0">@libro.Titulo</dd></div>
                    <div class="col-4"><dt>ISBN</dt><dd class="mb-0 bk-num">@libro.Isbn</dd></div>
                    <div class="col-12"><dt>Sinopsis</dt><dd class="mb-0">@libro.Sinopsis</dd></div>
                    <div class="col-4"><dt>Idioma</dt><dd class="mb-0">@libro.Idioma</dd></div>
                    <div class="col-4"><dt>Páginas</dt><dd class="mb-0 bk-num">@libro.Paginas</dd></div>
                    <div class="col-4"><dt>Año de publicación</dt><dd class="mb-0 bk-num">@libro.AnioPublicacion</dd></div>
                </dl>
            </section>
            <section class="bk-panel">
                <h2 class="h3 mb-3">Referencias</h2>
                <dl class="bk-kv row g-3 mb-0">
                    <div class="col-4"><dt>Autor</dt><dd class="mb-0"><a href="autores/@libro.Autor.Id">@libro.Autor.Nombre</a></dd></div>
                    <div class="col-4"><dt>Categoría</dt><dd class="mb-0"><a href="categorias/@libro.Categoria.Id">@libro.Categoria.Nombre</a></dd></div>
                    <div class="col-4"><dt>Editorial</dt><dd class="mb-0"><a href="editoriales/@libro.Editorial.Id">@libro.Editorial.Nombre</a></dd></div>
                </dl>
            </section>
            <section class="bk-panel">
                <h2 class="h3 mb-3">Precio y stock</h2>
                <dl class="bk-kv row g-3 mb-0">
                    <div class="col-4"><dt>Precio</dt><dd class="mb-0 bk-num">@Formato.Soles(libro.Precio)</dd></div>
                    <div class="col-4"><dt>Precio final hoy</dt><dd class="mb-0"><PriceTag Libro="libro" /></dd></div>
                    <div class="col-4"><dt>Stock</dt><dd class="mb-0"><span class="bk-num @(libro.Stock == 0 ? "text-danger fw-semibold" : "")">@libro.Stock</span></dd></div>
                </dl>
            </section>
            <section class="bk-panel">
                <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                    <div><h2 class="h3 mb-1">Descuentos</h2><p class="small text-muted mb-0">Primero los vigentes y programados. No pueden superponerse en fechas.</p></div>
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => modalDescuento.Abrir(libro)"><i class="bi bi-plus-lg me-1"></i>Agregar descuento</button>
                </div>
                @if (descuentos == null)
                {
                    <div class="placeholder-glow" aria-hidden="true"><span class="placeholder col-12 mb-2"></span><span class="placeholder col-12"></span></div>
                }
                else if (descuentos.Count == 0)
                {
                    <p class="small text-muted mb-0">Este libro no tiene descuentos.</p>
                }
                else
                {
                    <div class="bk-table-wrap">
                        <table class="table bk-table mb-0">
                            <thead><tr><th class="text-end">Porcentaje</th><th>Desde</th><th>Hasta</th><th>Estado</th><th class="text-end"><span class="visually-hidden">Acciones</span></th></tr></thead>
                            <tbody>
                                @foreach (Descuento descuento in descuentos.Take(descuentosVisibles))
                                {
                                    <tr>
                                        <td class="text-end bk-num">@descuento.Porcentaje %</td>
                                        <td class="bk-num">@Formato.Fecha(descuento.FechaInicio)</td>
                                        <td class="bk-num">@Formato.Fecha(descuento.FechaFin)</td>
                                        <td><StatusBadge Texto="@TextoEstado(descuento.Estado)" Tipo="@TipoEstado(descuento.Estado)" /></td>
                                        <td class="text-end">
                                            @if (descuento.Estado != EstadoDescuento.FINALIZADO)
                                            {
                                                <button type="button" class="btn btn-sm btn-link text-decoration-none text-danger p-0" @onclick="() => PedirEliminarDescuento(descuento)">Eliminar</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (descuentos.Count > descuentosVisibles)
                    {
                        <button type="button" class="btn btn-outline-secondary w-100 mt-3" @onclick="() => descuentosVisibles += 5">Ver más descuentos (@(descuentos.Count - descuentosVisibles))</button>
                    }
                }
            </section>
        </div>
    </div>
}
else
{
    @* Edición o alta: el mismo formulario *@
    <div class="bk-page-head"><h1>@(Id == null ? "Nuevo libro" : "Editar libro")</h1></div>
    <form id="form-libro" class="row g-4" @onsubmit="Guardar">
        <div class="col-3">
            <div class="bk-panel text-center">
                @if (edicion.Portada != null)
                {
                    <BookCover Libro="edicion" />
                }
                else
                {
                    <div class="bk-cover d-flex align-items-center justify-content-center text-muted" style="box-shadow:none;border:1px dashed var(--bk-line-strong)"><i class="bi bi-image fs-2"></i></div>
                }
                <label class="btn btn-sm btn-outline-secondary mt-3 w-100" for="portada">Elegir imagen</label>
                <InputFile id="portada" class="d-none" accept=".jpg,.jpeg,.png" OnChange="ElegirPortada" />
                <div class="form-text">Portada. JPG o PNG.</div>
            </div>
        </div>
        <div class="col-9 d-grid gap-4">
            <section class="bk-panel">
                <h2 class="h3 mb-3">Datos</h2>
                <div class="row g-3">
                    <div class="col-8"><label class="form-label" for="tit">Título</label><input class="form-control" id="tit" required maxlength="200" @bind="edicion.Titulo" /></div>
                    <div class="col-4"><label class="form-label" for="isbn">ISBN</label><input class="form-control bk-num" id="isbn" required maxlength="20" @bind="edicion.Isbn" /></div>
                    <div class="col-12"><label class="form-label" for="sin">Sinopsis</label><textarea class="form-control" id="sin" rows="4" @bind="edicion.Sinopsis"></textarea></div>
                    <div class="col-4">
                        <label class="form-label" for="idi">Idioma</label>
                        <select class="form-select" id="idi" @bind="edicion.Idioma"><option value="Español">Español</option><option value="Inglés">Inglés</option></select>
                    </div>
                    <div class="col-4"><label class="form-label" for="pag">Páginas</label><input class="form-control bk-num" id="pag" type="number" min="1" required @bind="edicion.Paginas" /></div>
                    <div class="col-4"><label class="form-label" for="anio">Año de publicación</label><input class="form-control bk-num" id="anio" type="number" min="1000" max="@DateTime.Today.Year" required @bind="edicion.AnioPublicacion" /></div>
                </div>
            </section>
            <section class="bk-panel">
                <h2 class="h3 mb-1">Referencias</h2>
                @if (Id != null)
                {
                    <p class="small text-muted mb-3">No se pueden cambiar después de registrar el libro.</p>
                    <div class="row g-3">
                        @foreach (var referencia in new[] { ("Autor", edicion.Autor.Nombre), ("Categoría", edicion.Categoria.Nombre), ("Editorial", edicion.Editorial.Nombre) })
                        {
                            <div class="col-4">
                                <span class="form-label d-block">@referencia.Item1</span>
                                <div class="form-control d-flex align-items-center gap-2" style="background:var(--bk-sunken)"><i class="bi bi-lock text-muted"></i>@referencia.Item2</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="small text-muted mb-3">Solo se muestran los activos. No podrán cambiarse después de registrar el libro.</p>
                    <div class="row g-3">
                        <div class="col-4">
                            <label class="form-label" for="aut">Autor</label>
                            <select class="form-select" id="aut" required @bind="idAutor"><option value="">Elige una opción</option>@foreach (Entidad e in autores) { <option value="@e.Id">@e.Nombre</option> }</select>
                        </div>
                        <div class="col-4">
                            <label class="form-label" for="cat">Categoría</label>
                            <select class="form-select" id="cat" required @bind="idCategoria"><option value="">Elige una opción</option>@foreach (Entidad e in categorias) { <option value="@e.Id">@e.Nombre</option> }</select>
                        </div>
                        <div class="col-4">
                            <label class="form-label" for="edi">Editorial</label>
                            <select class="form-select" id="edi" required @bind="idEditorial"><option value="">Elige una opción</option>@foreach (Entidad e in editoriales) { <option value="@e.Id">@e.Nombre</option> }</select>
                        </div>
                    </div>
                }
            </section>
            <section class="bk-panel">
                <h2 class="h3 mb-3">Precio y stock</h2>
                <div class="row g-3">
                    <div class="col-4"><label class="form-label" for="pre">Precio</label><div class="input-group"><span class="input-group-text">S/</span><input class="form-control bk-num" id="pre" type="number" step="0.01" min="0.01" required @bind="edicion.Precio" /></div></div>
                    <div class="col-4"><label class="form-label" for="sto">Stock</label><input class="form-control bk-num" id="sto" type="number" min="0" required @bind="edicion.Stock" /></div>
                </div>
                @if (Id == null)
                {
                    <div class="form-check form-switch mt-4">
                        <input class="form-check-input" type="checkbox" id="act" @bind="edicion.Activo" aria-describedby="act-ayuda" />
                        <label class="form-check-label fw-semibold" for="act">Activo</label>
                        <div class="form-text" id="act-ayuda">Los libros inactivos no se muestran en la tienda.</div>
                    </div>
                }
            </section>
        </div>
    </form>
    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top" style="border-color:var(--bk-line)!important;position:sticky;bottom:0;background:var(--bk-paper);padding-bottom:1rem">
        @if (Id != null)
        {
            <button type="button" class="btn btn-outline-secondary" disabled="@guardando" @onclick="() => editando = false">Cancelar</button>
        }
        else
        {
            <a class="btn btn-outline-secondary" href="admin/libros">Cancelar</a>
        }
        <button type="submit" form="form-libro" class="btn btn-primary" disabled="@guardando">
            @if (guardando)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            }
            @(Id == null ? "Registrar libro" : "Guardar cambios")
        </button>
    </div>
}

<DescuentoModal @ref="modalDescuento" OnGuardado="RecargarDescuentos" />
<ConfirmModal @ref="confirmacion" OnConfirmar="Confirmado" />
