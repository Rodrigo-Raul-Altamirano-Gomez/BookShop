@page "/admin/configuracion"
@layout AdminLayout
@attribute [Authorize(Roles = "ADMINISTRADOR")]

<PageTitle>Configuración · Administración · BookShop</PageTitle>

@if (configuracion == null)
{
    <div class="placeholder-glow" style="max-width:52rem" aria-hidden="true">
        <span class="placeholder placeholder-lg col-4 mb-4"></span>
        <span class="placeholder col-12 mb-3" style="height:6rem"></span><span class="placeholder col-12" style="height:8rem"></span>
    </div>
}
else if (!editando)
{
    @* Consulta (UX-UI §10.7) *@
    <div class="bk-page-head" style="max-width:52rem">
        <div><h1>Configuración</h1><p class="small text-muted mb-0 mt-1">Valores que rigen las operaciones nuevas de la tienda.</p></div>
        <button type="button" class="btn btn-primary" @onclick="Editar"><i class="bi bi-pencil me-2"></i>Editar configuración</button>
    </div>
    <div class="d-grid gap-4" style="max-width:52rem">
        <section class="bk-panel">
            <h2 class="h3 mb-3">Envío</h2>
            <dl class="bk-kv row g-3 mb-0"><div class="col-4"><dt>Costo de envío</dt><dd class="mb-0 bk-num">@Formato.Soles(configuracion.CostoEnvio)</dd></div></dl>
        </section>
        <section class="bk-panel">
            <h2 class="h3 mb-3">Devoluciones y cancelaciones</h2>
            <dl class="bk-kv row g-3 mb-0">
                <div class="col-4"><dt>Plazo de devolución</dt><dd class="mb-0 bk-num">@configuracion.DiasDevolucion días desde la entrega</dd></div>
                <div class="col-4"><dt>Solicitudes por pedido</dt><dd class="mb-0 bk-num">@configuracion.MaxSolicitudesDevolucion</dd></div>
                <div class="col-4"><dt>Cancelaciones por mes</dt><dd class="mb-0 bk-num">@configuracion.MaxCancelacionesMes por cliente</dd></div>
            </dl>
        </section>
        <section class="bk-panel">
            <h2 class="h3 mb-3">Cupones</h2>
            <dl class="bk-kv row g-3 mb-0">
                <div class="col-6"><dt>Monto mínimo del pedido</dt><dd class="mb-0 bk-num">@Formato.Soles(configuracion.CuponMontoMinimo)</dd></div>
                <div class="col-6"><dt>Pedidos para un cupón</dt><dd class="mb-0 bk-num">@configuracion.CuponCadaPedidos</dd></div>
                <div class="col-6"><dt>Descuento del cupón</dt><dd class="mb-0 bk-num">@configuracion.CuponPorcentaje %</dd></div>
                <div class="col-6"><dt>Vigencia del cupón</dt><dd class="mb-0 bk-num">@configuracion.CuponDiasVigencia días</dd></div>
            </dl>
        </section>
    </div>
}
else
{
    @* Edición *@
    <div class="bk-page-head" style="max-width:52rem"><h1>Editar configuración</h1></div>
    <div class="alert alert-info" style="max-width:52rem"><i class="bi bi-info-circle"></i><div>Los cambios se aplican a las operaciones nuevas. Los pedidos, cupones y solicitudes ya registrados no cambian.</div></div>
    <form class="d-grid gap-4" style="max-width:52rem" @onsubmit="Guardar">
        <section class="bk-panel">
            <h2 class="h3 mb-3">Envío</h2>
            <div class="row g-3">
                <div class="col-5">
                    <label class="form-label" for="env">Costo de envío</label>
                    <div class="input-group"><span class="input-group-text">S/</span><input class="form-control bk-num" id="env" type="number" step="0.01" min="0" required aria-describedby="env-ayuda" @bind="edicion.CostoEnvio" /></div>
                    <div class="form-text" id="env-ayuda">Se suma al total de cada pedido.</div>
                </div>
            </div>
        </section>
        <section class="bk-panel">
            <h2 class="h3 mb-3">Devoluciones y cancelaciones</h2>
            <div class="row g-3">
                <div class="col-4">
                    <label class="form-label" for="dd">Plazo de devolución</label>
                    <div class="input-group"><input class="form-control bk-num" id="dd" type="number" min="0" required aria-describedby="dd-ayuda" @bind="edicion.DiasDevolucion" /><span class="input-group-text">días</span></div>
                    <div class="form-text" id="dd-ayuda">Desde la entrega del pedido.</div>
                </div>
                <div class="col-4">
                    <label class="form-label" for="ms">Solicitudes por pedido</label>
                    <input class="form-control bk-num" id="ms" type="number" min="1" required aria-describedby="ms-ayuda" @bind="edicion.MaxSolicitudesDevolucion" />
                    <div class="form-text" id="ms-ayuda">Incluye las rechazadas y retiradas.</div>
                </div>
                <div class="col-4">
                    <label class="form-label" for="mc">Cancelaciones por mes</label>
                    <input class="form-control bk-num" id="mc" type="number" min="0" required aria-describedby="mc-ayuda" @bind="edicion.MaxCancelacionesMes" />
                    <div class="form-text" id="mc-ayuda">Por cliente, en el mes calendario.</div>
                </div>
            </div>
        </section>
        <section class="bk-panel">
            <h2 class="h3 mb-3">Cupones</h2>
            <div class="row g-3">
                <div class="col-6">
                    <label class="form-label" for="cm">Monto mínimo del pedido</label>
                    <div class="input-group"><span class="input-group-text">S/</span><input class="form-control bk-num" id="cm" type="number" step="0.01" min="0" required aria-describedby="cm-ayuda" @bind="edicion.CuponMontoMinimo" /></div>
                    <div class="form-text" id="cm-ayuda">Solo cuentan los pedidos con este total o más.</div>
                </div>
                <div class="col-6">
                    <label class="form-label" for="cc">Pedidos para un cupón</label>
                    <input class="form-control bk-num" id="cc" type="number" min="1" required aria-describedby="cc-ayuda" @bind="edicion.CuponCadaPedidos" />
                    <div class="form-text" id="cc-ayuda">Se emite un cupón cada vez que el cliente junta esta cantidad.</div>
                </div>
                <div class="col-6">
                    <label class="form-label" for="cp">Descuento del cupón</label>
                    <div class="input-group"><input class="form-control bk-num" id="cp" type="number" min="1" max="100" required @bind="edicion.CuponPorcentaje" /><span class="input-group-text">%</span></div>
                </div>
                <div class="col-6">
                    <label class="form-label" for="cv">Vigencia del cupón</label>
                    <div class="input-group"><input class="form-control bk-num" id="cv" type="number" min="1" required @bind="edicion.CuponDiasVigencia" /><span class="input-group-text">días</span></div>
                </div>
            </div>
        </section>
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-outline-secondary" disabled="@guardando" @onclick="() => editando = false">Cancelar</button>
            <button type="submit" class="btn btn-primary" disabled="@guardando">
                @if (guardando)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                }
                Guardar configuración
            </button>
        </div>
    </form>
}
