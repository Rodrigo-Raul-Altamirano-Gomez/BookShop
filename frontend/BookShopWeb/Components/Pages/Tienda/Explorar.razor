@page "/explorar/{Ruta}"

<PageTitle>Explorar @Entidades.Plural(tipo).ToLower() · BookShop</PageTitle>

<div class="container-xl pt-4">
    <nav aria-label="Ruta"><ol class="breadcrumb bk-breadcrumb mb-2"><li class="breadcrumb-item"><a href="">Inicio</a></li><li class="breadcrumb-item active" aria-current="page">Explorar</li></ol></nav>
    <h1 class="mb-4">Explorar</h1>
    <ul class="nav nav-underline mb-4">
        @foreach (TipoEntidad pestana in pestanas)
        {
            <li class="nav-item"><NavLink class="nav-link" href="@("explorar/" + Entidades.Ruta(pestana))">@Entidades.Plural(pestana)</NavLink></li>
        }
    </ul>
    <form class="bk-toolbar" role="search" @onsubmit="() => { }">
        <div class="bk-search flex-grow-1" style="max-width:24rem">
            <i class="bi bi-search"></i>
            <input class="form-control" type="search" style="background:var(--bk-surface)" placeholder="@TextoBusqueda" aria-label="@TextoBusqueda" @bind="busqueda" @bind:after="Buscar" />
        </div>
        @if (resultado != null)
        {
            <span class="small text-muted bk-num">@resultado.Total @Entidades.Plural(tipo).ToLower()</span>
        }
        <div class="ms-auto d-flex align-items-center gap-2">
            <label class="small text-muted text-nowrap" for="orden">Ordenar por</label>
            <select class="form-select form-select-sm" id="orden" style="width:auto" @bind="orden" @bind:after="Buscar">
                <option value="nombre-asc">Nombre A–Z</option>
                <option value="nombre-desc">Nombre Z–A</option>
            </select>
        </div>
    </form>

    @if (resultado == null)
    {
        <div class="bk-grid-6">
            @for (int i = 0; i < 12; i++)
            {
                <div class="placeholder-glow text-center" aria-hidden="true"><div class="bk-entity-img placeholder"></div><span class="placeholder col-8 mt-2"></span></div>
            }
        </div>
    }
    else if (resultado.Elementos.Count == 0)
    {
        <EmptyState Titulo="Sin coincidencias." Texto="Prueba con otro nombre." TextoAccion="Ver todos" Url="@("explorar/" + Entidades.Ruta(tipo))" />
    }
    else
    {
        <div class="bk-grid-6">
            @foreach (Entidad entidad in resultado.Elementos)
            {
                <div><EntityCard Entidad="entidad" /></div>
            }
        </div>
        <div class="d-flex justify-content-center mt-5">
            <Paginacion Pagina="Pagina ?? 1" TotalPaginas="TotalPaginas" OnCambio="CambiarPagina" />
        </div>
    }
</div>
