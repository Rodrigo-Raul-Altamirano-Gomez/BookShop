@page "/compra/confirmacion/{Id:int}"
@attribute [Authorize(Roles = "CLIENTE")]

<PageTitle>Compra confirmada · BookShop</PageTitle>

@* RF16.2 y UX-UI §8.12 *@
<div class="container-xl pt-5">
    <div class="bk-panel mx-auto text-center p-5" style="max-width:40rem">
        @if (pedido == null)
        {
            <div class="placeholder-glow" aria-hidden="true">
                <span class="placeholder d-block rounded-circle mx-auto mb-4" style="width:3.5rem;height:3.5rem"></span>
                <span class="placeholder placeholder-lg d-block col-8 mx-auto mb-3"></span>
                <span class="placeholder d-block col-7 mx-auto mb-4"></span>
                <span class="placeholder d-block col-6 mx-auto mb-4" style="height:7rem"></span>
                <span class="placeholder d-block col-5 mx-auto" style="height:2.5rem"></span>
            </div>
        }
        else
        {
            <div class="mx-auto mb-4 d-flex align-items-center justify-content-center" style="width:3.5rem;height:3.5rem;border-radius:50%;background:var(--bk-green);color:#fff"><i class="bi bi-check-lg fs-3"></i></div>
            <h1 class="bk-display mb-2">¡Gracias por tu compra!</h1>
            <p class="text-muted mb-4">Tu pedido <strong class="text-body">N.º @pedido.Id</strong> fue registrado y ya está en el almacén.</p>
            <dl class="bk-kv text-start mx-auto mb-4 p-3" style="max-width:24rem;background:var(--bk-sunken);border-radius:var(--bk-radius)">
                <dt>Código de transacción</dt><dd><span class="bk-code">@pedido.CodigoTransaccion</span></dd>
                <dt>Código de seguimiento</dt><dd><span class="bk-code">@pedido.CodigoSeguimiento</span></dd>
                <dt>Total pagado</dt><dd class="mb-0" style="font-family:var(--bk-font-serif);font-size:1.5rem;font-weight:600">@Formato.Soles(pedido.Total)</dd>
            </dl>
            <div class="d-flex justify-content-center gap-2">
                <a class="btn btn-primary" href="comprobantes/@pedido.Id" target="_blank"><i class="bi bi-file-earmark-arrow-down me-2"></i>Descargar comprobante</a>
                <a class="btn btn-outline-secondary" href="cuenta/pedidos/@pedido.Id">Ver pedido</a>
            </div>
            <a class="d-inline-block mt-4 small fw-semibold" href="catalogo">Seguir comprando</a>
        }
    </div>
</div>
