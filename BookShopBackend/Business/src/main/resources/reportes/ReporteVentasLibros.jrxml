<?xml version="1.0" encoding="UTF-8"?>
<!-- RF18 - Libros ordenados por monto vendido en un período (JasperReports 7.0.6).
     Paleta y tipografía del proyecto BookShop (wwwroot/app.css): verde #0B453A, texto #172332, gris #66717E.
     Ábrelo en Jaspersoft Studio 7.x y pulsa Compile para generar el .jasper en esta misma carpeta. -->
<jasperReport name="ReporteVentasLibros" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="24" whenNoDataType="AllSectionsNoDetail" uuid="312f3f49-b84e-4ba6-b5ce-1abc1e1bddad">
	<property name="net.sf.jasperreports.export.pdf.metadata.title" value="Reporte de ventas por libro - BookShop"/>
	<property name="net.sf.jasperreports.export.pdf.metadata.author" value="BookShop"/>
	<property name="net.sf.jasperreports.export.pdf.metadata.subject" value="Libros ordenados por monto vendido"/>
	<style name="Normal" default="true" forecolor="#172332" fontName="DejaVu Sans" fontSize="8.5" bold="false" italic="false" underline="false" strikeThrough="false"/>
	<style name="Negrita" style="Normal" bold="true"/>
	<style name="Marca" forecolor="#0B453A" fontName="DejaVu Serif" fontSize="20.0" bold="true" italic="false" underline="false" strikeThrough="false"/>
	<style name="Subtitulo" forecolor="#0B453A" fontName="DejaVu Sans" fontSize="11.0" bold="true" italic="false" underline="false" strikeThrough="false"/>
	<style name="Seccion" forecolor="#66717E" fontName="DejaVu Sans" fontSize="7.5" bold="true" italic="false" underline="false" strikeThrough="false"/>
	<style name="Cabecera" mode="Opaque" forecolor="#FFFFFF" backcolor="#0B453A" fontName="DejaVu Sans" fontSize="8.5" bold="true" italic="false" underline="false" strikeThrough="false"/>
	<style name="Bloque" mode="Opaque" forecolor="#172332" backcolor="#EEF3EC" fontName="DejaVu Sans" fontSize="9.0" bold="false" italic="false" underline="false" strikeThrough="false"/>
	<style name="Fila" mode="Opaque" forecolor="#172332" backcolor="#FFFFFF" fontName="DejaVu Sans" fontSize="8.5" bold="false" italic="false" underline="false" strikeThrough="false">
		<conditionalStyle backcolor="#FAFBF7">
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
		</conditionalStyle>
	</style>
	<style name="FilaNegrita" style="Fila" bold="true"/>
	<style name="Descuento" forecolor="#B43D3D" fontName="DejaVu Sans" fontSize="9.0" bold="false" italic="false" underline="false" strikeThrough="false"/>
	<style name="Total" forecolor="#07352D" fontName="DejaVu Sans" fontSize="11.0" bold="true" italic="false" underline="false" strikeThrough="false"/>
	<style name="FilaTotal" mode="Opaque" forecolor="#07352D" backcolor="#EEF3EC" fontName="DejaVu Sans" fontSize="9.0" bold="true" italic="false" underline="false" strikeThrough="false"/>
	<style name="Pie" forecolor="#66717E" fontName="DejaVu Sans" fontSize="7.5" bold="false" italic="false" underline="false" strikeThrough="false"/>
	<parameter name="periodo" class="java.lang.String"/>
	<parameter name="limite" class="java.lang.String"/>
	<parameter name="cantidadResultados" class="java.lang.Integer"/>
	<parameter name="fechaGeneracion" class="java.lang.String"/>
	<field name="posicion" class="java.lang.Integer"/>
	<field name="titulo" class="java.lang.String"/>
	<field name="categoria" class="java.lang.String"/>
	<field name="autor" class="java.lang.String"/>
	<field name="editorial" class="java.lang.String"/>
	<field name="cantidadVendida" class="java.lang.Long"/>
	<field name="importeVentas" class="java.math.BigDecimal"/>
	<variable name="totalEjemplares" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{cantidadVendida}]]></expression>
	</variable>
	<variable name="totalImporte" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{importeVentas}]]></expression>
	</variable>
	<title height="78">
		<element kind="staticText" uuid="74a3eb5a-527a-4524-b5c0-a9c1322a74c9" x="0" y="0" width="250" height="26" style="Marca">
			<text><![CDATA[BookShop]]></text>
		</element>
		<element kind="staticText" uuid="09b0315a-d3a6-4c0c-8208-9bf6ed794000" x="250" y="4" width="532" height="20" hTextAlign="Right" style="Subtitulo">
			<text><![CDATA[REPORTE DE VENTAS POR LIBRO]]></text>
		</element>
		<element kind="line" uuid="397ecf02-a71e-45f7-821a-75c4d9c8edf3" x="0" y="32" width="782" height="1" forecolor="#0B453A"/>
