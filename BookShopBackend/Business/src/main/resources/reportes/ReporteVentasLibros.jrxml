			<box leftPadding="5"/>
		</element>
		<element kind="staticText" uuid="bf70fb84-645f-4af8-8592-ffe52412eab8" x="632" y="0" width="60" height="24" hTextAlign="Right" vTextAlign="Middle" style="Cabecera">
			<text><![CDATA[Ejemplares]]></text>
			<box rightPadding="5"/>
		</element>
		<element kind="staticText" uuid="97b1519b-bd9c-4e59-9803-999142ec5f2a" x="692" y="0" width="90" height="24" hTextAlign="Right" vTextAlign="Middle" style="Cabecera">
			<text><![CDATA[Monto vendido]]></text>
			<box rightPadding="5"/>
		</element>
	</columnHeader>
	<detail>
		<band height="21" splitType="Prevent">
			<element kind="textField" uuid="bbafc827-9068-4a09-b31a-77de49ec63e2" stretchType="ContainerHeight" x="0" y="0" width="32" height="20" hTextAlign="Center" vTextAlign="Middle" style="Fila">
				<expression><![CDATA[$F{posicion}]]></expression>
			</element>
			<element kind="textField" uuid="b1fc59ba-3e56-4f52-834f-dfd73b662a78" textAdjust="StretchHeight" x="32" y="0" width="230" height="20" vTextAlign="Middle" style="Fila">
				<expression><![CDATA[$F{titulo}]]></expression>
				<box topPadding="3" leftPadding="5" bottomPadding="3"/>
			</element>
			<element kind="textField" textAdjust="StretchHeight" uuid="fe4d395a-dda5-4ca3-967f-47f3647b8840" stretchType="ContainerHeight" x="262" y="0" width="115" height="20" vTextAlign="Middle" style="Fila">
				<expression><![CDATA[$F{categoria}]]></expression>
				<box leftPadding="5"/>
			</element>
			<element kind="textField" textAdjust="StretchHeight" uuid="ce00393d-7527-4e1c-a05c-ebc283ecf75d" stretchType="ContainerHeight" x="377" y="0" width="135" height="20" vTextAlign="Middle" style="Fila">
				<expression><![CDATA[$F{autor}]]></expression>
				<box leftPadding="5"/>
			</element>
			<element kind="textField" textAdjust="StretchHeight" uuid="0e4ff136-f977-448f-9d12-8dce88c0ed7b" stretchType="ContainerHeight" x="512" y="0" width="120" height="20" vTextAlign="Middle" style="Fila">
				<expression><![CDATA[$F{editorial}]]></expression>
				<box leftPadding="5"/>
			</element>
			<element kind="textField" uuid="3cc676e9-a56b-4c68-94d3-460288d7afba" stretchType="ContainerHeight" x="632" y="0" width="60" height="20" pattern="#,##0" hTextAlign="Right" vTextAlign="Middle" style="Fila">
				<expression><![CDATA[$F{cantidadVendida}]]></expression>
				<box rightPadding="5"/>
			</element>
			<element kind="textField" uuid="f3685a42-d53e-44f3-a16f-d8db7dce9c5e" stretchType="ContainerHeight" x="692" y="0" width="90" height="20" pattern="S/ #,##0.00" hTextAlign="Right" vTextAlign="Middle" style="FilaNegrita">
				<expression><![CDATA[$F{importeVentas}]]></expression>
				<box rightPadding="5"/>
