	<summary height="50">
		<element kind="staticText" uuid="8bd8dcf7-9fa5-428d-a9e9-a375b830a9cf" x="0" y="6" width="632" height="22" vTextAlign="Middle" style="FilaTotal">
			<text><![CDATA[TOTAL]]></text>
			<box leftPadding="5"/>
		</element>
		<element kind="textField" uuid="46875d8d-3fdb-425d-b197-7eb17d583197" x="632" y="6" width="60" height="22" pattern="#,##0" hTextAlign="Right" vTextAlign="Middle" style="FilaTotal">
			<expression><![CDATA[$V{totalEjemplares} == null ? 0L : $V{totalEjemplares}]]></expression>
			<box rightPadding="5"/>
		</element>
		<element kind="textField" uuid="fad533e3-ce92-4f4f-8b10-e010ef457a35" x="692" y="6" width="90" height="22" pattern="S/ #,##0.00" hTextAlign="Right" vTextAlign="Middle" style="FilaTotal">
			<expression><![CDATA[$V{totalImporte} == null ? java.math.BigDecimal.ZERO : $V{totalImporte}]]></expression>
			<box rightPadding="5"/>
		</element>
		<element kind="staticText" uuid="6430e6a0-9ef4-4ebf-b30d-bfece8e17d15" x="0" y="32" width="782" height="14" style="Pie">
			<printWhenExpression><![CDATA[$P{cantidadResultados} == 0]]></printWhenExpression>
			<text><![CDATA[No se registraron ventas válidas en el período seleccionado.]]></text>
		</element>
