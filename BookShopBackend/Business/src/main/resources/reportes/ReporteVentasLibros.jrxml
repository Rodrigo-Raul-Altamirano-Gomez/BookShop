			<expression><![CDATA["Período: " + $P{periodo}]]></expression>
		</element>
		<element kind="textField" uuid="01c7acc9-a00a-42a6-9767-568ef774b083" x="390" y="40" width="392" height="14" hTextAlign="Right" style="Normal">
			<expression><![CDATA["Resultados: " + $P{cantidadResultados} + "  ·  Límite: " + $P{limite}]]></expression>
		</element>
		<element kind="staticText" uuid="3af41fce-6c62-4655-a513-6250839834c3" x="0" y="56" width="782" height="14" style="Pie">
			<text><![CDATA[Ordenado por monto vendido (después del descuento del libro, antes de cupón y envío). Excluye pedidos cancelados y devueltos.]]></text>
		</element>
	</title>
	<columnHeader height="24">
		<element kind="staticText" uuid="1d12bf57-db9d-43cd-84fd-b8804165e730" x="0" y="0" width="32" height="24" hTextAlign="Center" vTextAlign="Middle" style="Cabecera">
