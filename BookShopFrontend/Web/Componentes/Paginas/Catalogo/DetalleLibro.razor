@page "/libros/{Id:int}"
<PageTitle>@(Libro?.Titulo ?? "Libro") · BookShop</PageTitle>
<div class="container detail-page">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="/catalogo">Catálogo</a></li>
            <li class="breadcrumb-item active" aria-current="page"><span>@Libro?.Titulo</span></li>
        </ol>
    </nav>
    @if (Libro is null)
    {
        <div class="empty-state">
            <h1>Libro no encontrado</h1>
            <a href="/catalogo" class="btn btn-primary">Volver al catálogo</a>
        </div>
    }
    else
    {
        <section class="book-detail row g-5">
            <div class="cover-column col-12 col-md-4">
                <img
                    class="detail-cover"
                    onerror="this.onerror=null;this.src='/images/book-placeholder.svg'"
                    src="@Libro.Portada"
                    alt="@($"Portada de {Libro.Titulo}")"
                    />
                @if (Estado.EsAdministrador)
                {
                    <div class="image-actions d-flex gap-2">
                        <label class="btn btn-outline-secondary icon-button" title="Cambiar portada">
                            <Icono Nombre="edit" />
                            <InputFile class="form-control"
                                OnChange="CambiarImagen"
                                disabled="@cargandoImagen"
                                accept="image/png,image/jpeg"
                                />
                        </label>
                        <button
                            class="btn btn-outline-secondary icon-button"
                            title="Quitar portada"
                            disabled="@cargandoImagen"
                            @onclick="QuitarImagen">
                            <Icono Nombre="trash" />
                        </button>
                    </div>
                }
            </div>
            <div class="book-information col-12 col-md-8">
                <h1>@Libro.Titulo</h1>
                <div class="book-references d-flex flex-wrap align-items-center gap-2">
                    <a href="@RutaReferencia("autores", Libro.Autor)">@Libro.Autor</a>
                    <span>·</span>
                    <a href="@RutaReferencia("categorias", Libro.Categoria)">@Libro.Categoria</a>
                    <span>·</span>
                    <a href="@RutaReferencia("editoriales", Libro.Editorial)">@Libro.Editorial</a>
                </div>
                <p class="language">Idioma: @Libro.Idioma</p>
                <div class="detail-rating d-flex flex-wrap align-items-center gap-3">
                    @if (Resenas.Count > 0)
                    {
                        <span
                            class="stars average-stars"
                            style="@EstiloPromedio"
                            aria-label="@($"Valoración {Promedio:N1} de 5")">
                            ★★★★★
                        </span>
                        <strong>@Promedio.ToString("N1") / 5</strong>
                    }
                    else
                    {
                        <span class="text-body-secondary">Sin reseñas</span>
                    }
                    <a href="#resenas">Ver reseñas (@Resenas.Count)</a>
                </div>
                <div class="detail-price">
                    @if (Libro.Descuento > 0)
                    {
                        <del>@EstadoDemostracion.Dinero(Libro.PrecioOriginal)</del>
                    }
                    <div>
                        <strong>@EstadoDemostracion.Dinero(Libro.Precio)</strong>
                        @if (Libro.Descuento > 0)
                        {
                            <span class="badge badge-bookshop discount-badge">-@Libro.Descuento%</span>
                        }
                    </div>
                </div>
                <p class="availability d-flex align-items-center gap-2">
                    <span class="availability-dot @(Libro.Stock == 0 || !Libro.Activo ? "unavailable" : "")">
                    </span>
                    @(Libro.Stock > 0 && Libro.Activo ? $"Disponible · {Libro.Stock} unidades" : "No disponible")
                </p>
                <div class="purchase-actions d-flex gap-2">
                    <div class="quantity-control btn-group align-items-center">
                        <button
                            class="btn btn-outline-secondary"
                            @onclick="Disminuir"
                            aria-label="Reducir cantidad"
                            disabled="@(cantidad <= 1)">
                            −
                        </button>
                        <span>@cantidad</span>
                        <button
                            class="btn btn-outline-secondary"
                            @onclick="Aumentar"
                            aria-label="Aumentar cantidad">+</button>
                    </div>
                    <button
                        class="btn btn-primary add-cart"
                        @onclick="AgregarCarrito"
                        disabled="@(Libro.Stock == 0 || !Libro.Activo)">
                        <Icono Nombre="cart" />
                        Agregar al carrito
                    </button>
                </div>
                <div class="list-actions d-flex flex-wrap align-items-center gap-2">
                    <button class="btn btn-secondary @(Deseado ? "selected" : "")" @onclick="AlternarDeseado">
                        <Icono Nombre="heart" />
                        @(Deseado ? "En deseados" : "Deseados")
                    </button>
                    <button class="btn btn-secondary @(Favorito ? "selected" : "")" @onclick="AlternarFavorito">
                        <Icono Nombre="star" />
                        @(Favorito ? "En favoritos" : "Favoritos")
                    </button>
                    <button class="btn btn-secondary" @onclick="Comparar">
                        <Icono Nombre="compare" />
                        Comparar
                    </button>
                </div>
                @if (Estado.EsAdministrador)
                {
                    <GestionLibro Libro="Libro" />
                }
            </div>
        </section>
        <section class="synopsis">
            <h2>Sinopsis</h2>
            <p class="@(sinopsisCompleta ? "" : "synopsis-preview")">@Libro.Sinopsis</p>
            <button class="btn btn-link text-button" @onclick="AlternarSinopsis">
                @(sinopsisCompleta ? "Leer menos ↑" : "Leer más ↓")
            </button>
        </section>
        <section class="technical-panel card bookshop-panel">
            <button
                class="technical-heading btn btn-link text-decoration-none d-flex align-items-center gap-3"
                @onclick="AlternarFicha"
                aria-expanded="@fichaExpandida">
                <span>@(fichaExpandida ? "⌃" : "⌄")</span>
                <h3>Ver detalles</h3>
            </button>
            @if (fichaExpandida)
            {
                <dl class="technical-data row gx-5">
                    <div class="col-12 col-md-6 d-flex">
                        <dt>Idioma</dt>
                        <dd>@Libro.Idioma</dd>
                    </div>
                    <div class="col-12 col-md-6 d-flex">
                        <dt>ISBN</dt>
                        <dd>@Libro.ISBN</dd>
                    </div>
                    <div class="col-12 col-md-6 d-flex">
                        <dt>Año de edición</dt>
                        <dd>@Libro.Anio</dd>
                    </div>
                    <div class="col-12 col-md-6 d-flex">
                        <dt>Páginas</dt>
                        <dd>@Libro.Paginas</dd>
                    </div>
                    <div class="col-12 col-md-6 d-flex">
                        <dt>Peso</dt>
                        <dd>@Libro.Peso</dd>
                    </div>
                    <div class="col-12 col-md-6 d-flex">
                        <dt>Dimensiones</dt>
                        <dd>@Libro.Dimensiones</dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Libro.Saga))
                    {
                        <div class="col-12 col-md-6 d-flex">
                            <dt>Saga</dt>
                            <dd>@Libro.Saga</dd>
                        </div>
                    }
                    @if (Libro.Tomo is not null)
                    {
                        <div class="col-12 col-md-6 d-flex">
                            <dt>Tomo</dt>
                            <dd>@Libro.Tomo</dd>
                        </div>
                    }
                </dl>
            }
        </section>
        <section class="similar-section">
            <div class="section-heading d-flex flex-wrap align-items-center justify-content-between gap-3">
                <h2>Libros similares</h2>
            </div>
            <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-4">
                @foreach (var similar in LibrosSimilares)
                {
                    <TarjetaLibro Libro="similar" />
                }
            </div>
        </section>
        <section class="reviews-panel card bookshop-panel" id="resenas">
            <div class="section-heading d-flex flex-wrap align-items-center justify-content-between gap-3">
                <h2>Reseñas</h2>
                <button class="btn btn-primary" @onclick="AbrirResena">
                    <Icono Nombre="edit" />
                    Escribir reseña
                </button>
            </div>
            <div class="reviews-layout row g-4">
                <div class="reviews-summary col-12 col-lg-3">
                    @if (Resenas.Count > 0)
                    {
                        <div class="average d-flex flex-column gap-2">
                            <strong>
                                @Promedio.ToString("N1")
                                <small> / 5</small>
                            </strong>
                            <span class="stars average-stars" style="@EstiloPromedio">★★★★★</span>
                        </div>
                    }
                    else
                    {
                        <h3>Sin reseñas</h3>
                    }
                    <p class="text-body-secondary">@Resenas.Count reseñas</p>
                    @foreach (var rating in Puntuaciones)
                    {
                        <div class="distribution d-flex align-items-center gap-2">
                            <span>
                                @rating
                                <span class="stars">★</span>
                            </span>
                            <div class="distribution-track progress flex-grow-1">
                                <span class="progress-bar" style="@($"width:{PorcentajePuntuacion(rating)}%")">
                                </span>
                            </div>
                            <span>@Resenas.Count(r => r.Puntuacion == rating)</span>
                        </div>
                    }
                </div>
                <div class="reviews-list col-12 col-lg-9">
                    @if (Resenas.Count == 0)
                    {
                        <div class="empty-state">
                            <p>Comparte tu opinión sobre este libro.</p>
                        </div>
                    }
                    @foreach (var review in ResenasVisibles)
                    {
                        <article class="review-row d-flex align-items-start gap-3">
                            <img class="review-avatar" src="@review.FotoUsuario" alt="" />
                            <div class="review-content d-flex flex-column gap-2 flex-grow-1">
                                <strong>@review.Usuario</strong>
                                <span class="text-body-secondary">
                                    @review.Fecha.ToString("d 'de' MMMM 'de' yyyy", CulturaEspanola)
                                </span>
                                <span class="stars" aria-label="@($"{review.Puntuacion} de 5 estrellas")">
                                    @TextoEstrellas(review.Puntuacion)
                                </span>
                                <p>@review.Comentario</p>
                            </div>
                            <div class="review-actions d-flex gap-2 align-self-center">
                                <button
                                    class="btn btn-outline-secondary icon-button
                                        @(review.Votada ? "selected" : "")"
                                    @onclick="() => Votar(review)"
                                    title="Marcar reseña como útil"
                                    aria-label="Marcar reseña como útil">
                                    <Icono Nombre="thumb" />
                                    @review.Votos
                                </button>
                                <button
                                    class="btn btn-outline-secondary icon-button"
                                    @onclick="() => AbrirReporte(review)"
                                    title="Reportar reseña"
                                    aria-label="Reportar reseña">
                                    <Icono Nombre="flag" />
                                </button>
                            </div>
                        </article>
                    }
                    <Paginacion
                        Pagina="paginaResenas"
                        TotalPaginas="PaginasResenas"
                        PaginaCambiada="CambiarPaginaResenas"
                        />
                </div>
            </div>
        </section>
    }
</div>
@if (modalResena && Libro is not null)
{
    <Modal Titulo="Escribir reseña" AlCerrar="CerrarResena">
        <form @onsubmit="PublicarResena" @onsubmit:preventDefault>
            <p class="form-book">@Libro.Titulo</p>
            <div class="field form-label d-block">
                <label>Puntuación *</label>
                <div class="rating-picker d-flex gap-1">
                    @foreach (var rating in PuntuacionesAscendentes)
                    {
                        <button
                            type="button"
                            class="btn btn-link p-0 @(rating <= puntuacionResena ? "chosen" : "")"
                            @onclick="() => SeleccionarPuntuacion(rating)"
                            aria-label="@($"Puntuar con {rating} estrellas")">
                            ★
                        </button>
                    }
                </div>
            </div>
            <div class="field form-label d-block">
                <label for="review-comment">Comentario *</label>
                <textarea
                    class="form-control"
                    id="review-comment" rows="5"
                    @bind="comentarioResena"
                    @bind:event="oninput">
                </textarea>
            </div>
            @if (errorFormulario.Length > 0)
            {
                <p class="alert alert-danger py-2">@errorFormulario</p>
            }
            <div class="modal-footer px-0 pb-0 d-flex flex-wrap justify-content-end gap-2 mt-4">
                <button type="button" class="btn btn-secondary" @onclick="CerrarResena">Cancelar</button>
                <button
                    type="submit"
                    class="btn btn-primary"
                    disabled="@(puntuacionResena == 0 || string.IsNullOrWhiteSpace(comentarioResena))">
                    Publicar reseña
                </button>
            </div>
        </form>
    </Modal>
}
@if (modalReporte)
{
    <Modal Titulo="Reportar reseña" AlCerrar="CerrarReporte">
        <form @onsubmit="EnviarReporte" @onsubmit:preventDefault>
            <div class="field form-label d-block">
                <label for="report-reason">Motivo *</label>
                <select class="form-select" id="report-reason" @bind="motivoReporte">
                    <option value="">Seleccionar motivo</option>
                    <option>Contenido ofensivo</option>
                    <option>Publicidad/spam</option>
                    <option>Contenido ajeno al libro</option>
                    <option>Otro</option>
                </select>
            </div>
            <div class="field form-label d-block">
                <label for="report-comment">Comentario adicional</label>
                <textarea
                    class="form-control"
                    id="report-comment" rows="4"
                    @bind="comentarioReporte"
                    @bind:event="oninput">
                </textarea>
            </div>
            @if (errorFormulario.Length > 0)
            {
                <p class="alert alert-danger py-2">@errorFormulario</p>
            }
            <div class="modal-footer px-0 pb-0 d-flex flex-wrap justify-content-end gap-2 mt-4">
                <button type="button" class="btn btn-secondary" @onclick="CerrarReporte">Cancelar</button>
                <button type="submit" class="btn btn-primary" disabled="@(motivoReporte.Length == 0)">
                    Enviar reporte
                </button>
            </div>
        </form>
    </Modal>
}
