<div class="filter-group">
    <h3>@Titulo</h3>
    <form class="filter-search d-flex gap-2 mb-3" @onsubmit="Buscar" @onsubmit:preventDefault>
        <input class="form-control"
            aria-label="@($"Buscar {Singular}")"
            placeholder="@($"Buscar {Singular}")"
            @bind="textoBusqueda"
            @bind:event="oninput"
            />
        <button class="btn btn-primary" type="submit">Buscar</button>
    </form>
    <div class="filter-options d-grid gap-2 overflow-auto">
        @foreach (var option in VisibleOptions)
        {
            <label class="form-check d-flex align-items-center gap-2">
                <input class="form-check-input"
                    type="checkbox"
                    checked="@Seleccionados.Contains(option)"
                    @onchange="() => Seleccionar(option)"
                    />
                <span>@option</span>
            </label>
        }
        @if (!VisibleOptions.Any())
        {
            <p class="text-body-secondary">Sin coincidencias</p>
        }
    </div>
    @if (OpcionesFiltradas.Count > 4)
    {
        <button class="btn btn-link text-button" @onclick="AlternarExpansion">
            @(expandido ? "Ver menos" : "Ver más")
            <span aria-hidden="true">→</span>
        </button>
    }
</div>
