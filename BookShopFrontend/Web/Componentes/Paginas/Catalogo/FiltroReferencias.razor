<div class="filter-group">
    <h3>@Titulo</h3>
    <form class="filter-search" @onsubmit="Buscar" @onsubmit:preventDefault>
        <input
            aria-label="@($"Buscar {Singular}")"
            placeholder="@($"Buscar {Singular}")"
            @bind="textoBusqueda"
            @bind:event="oninput"
            />
        <button class="btn btn-primary" type="submit">Buscar</button>
    </form>
    <div class="filter-options">
        @foreach (var option in VisibleOptions)
        {
            <label>
                <input
                    type="checkbox"
                    checked="@Seleccionados.Contains(option)"
                    @onchange="() => Seleccionar(option)"
                    />
                <span>@option</span>
            </label>
        }
        @if (!VisibleOptions.Any())
        {
            <p class="muted">Sin coincidencias</p>
        }
    </div>
    @if (OpcionesFiltradas.Count > 4)
    {
        <button class="text-button" @onclick="AlternarExpansion">
            @(expandido ? "Ver menos" : "Ver más")
            <span aria-hidden="true">→</span>
        </button>
    }
</div>
