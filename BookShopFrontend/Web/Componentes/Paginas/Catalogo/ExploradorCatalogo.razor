<div class="row g-4">
    <aside class="filters col-12 col-lg-3">
        <h2>Filtros</h2>
        @if (Administracion)
        {
            <div class="filter-group">
                <label class="form-check d-flex align-items-center gap-2 ps-0">
                    <input class="form-check-input m-0" type="checkbox" @bind="soloActivos" />
                    Solo activos
                </label>
            </div>
        }
        @if (TipoAmbito != "categorias")
        {
            <FiltroReferencias
                Titulo="Categorías"
                Singular="categoría"
                Opciones="OpcionesCategorias"
                Seleccionados="categorias"
                SeleccionCambiada="SeleccionarCategoria"
                />
        }
        @if (TipoAmbito != "autores")
        {
            <FiltroReferencias
                Titulo="Autores"
                Singular="autor"
                Opciones="OpcionesAutores"
                Seleccionados="autores"
                SeleccionCambiada="SeleccionarAutor"
                />
        }
        @if (TipoAmbito != "editoriales")
        {
            <FiltroReferencias
                Titulo="Editoriales"
                Singular="editorial"
                Opciones="OpcionesEditoriales"
                Seleccionados="editoriales"
                SeleccionCambiada="SeleccionarEditorial"
                />
        }
        <FiltroReferencias
            Titulo="Idiomas"
            Singular="idioma"
            Opciones="OpcionesIdiomas"
            Seleccionados="idiomas"
            SeleccionCambiada="SeleccionarIdioma"
            />
        <div class="filter-group">
            <h3>Precio</h3>
            <div class="price-sliders" style="@EstiloRango">
                <input class="form-range"
                    type="range"
                    min="0"
                    max="@LimitePrecio"
                    step="1"
                    aria-label="Precio mínimo"
                    @bind="minimo"
                    @bind:after="AjustarMinimo"
                    />
                <input class="form-range"
                    type="range"
                    min="0"
                    max="@LimitePrecio"
                    step="1"
                    aria-label="Precio máximo"
                    @bind="maximo"
                    @bind:after="AjustarMaximo"
                    />
            </div>
            <div class="row g-2">
                <label class="col-6 form-label">
                    Mínimo
                    <input class="form-control"
                        type="number"
                        min="0"
                        max="@LimitePrecio"
                        step="1"
                        @bind="minimo"
                        @bind:event="oninput"
                        @bind:after="AjustarMinimo"
                        />
                </label>
                <label class="col-6 form-label">
                    Máximo
                    <input class="form-control"
                        type="number"
                        min="0"
                        max="@LimitePrecio"
                        step="1"
                        @bind="maximo"
                        @bind:event="oninput"
                        @bind:after="AjustarMaximo"
                        />
                </label>
            </div>
        </div>
        <div class="filter-group active-filters border-top pt-3">
            <h3>Filtros activos</h3>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var item in categoriasAplicadas)
                {
                    <button
                        class="btn btn-sm btn-outline-secondary rounded-pill"
                        @onclick="() => QuitarCategoria(item)">
                        @item
                        <Icono Nombre="close" />
                    </button>
                }
                @foreach (var item in autoresAplicados)
                {
                    <button
                        class="btn btn-sm btn-outline-secondary rounded-pill"
                        @onclick="() => QuitarAutor(item)">
                        @item
                        <Icono Nombre="close" />
                    </button>
                }
                @foreach (var item in editorialesAplicadas)
                {
                    <button
                        class="btn btn-sm btn-outline-secondary rounded-pill"
                        @onclick="() => QuitarEditorial(item)">
                        @item
                        <Icono Nombre="close" />
                    </button>
                }
                @foreach (var item in idiomasAplicados)
                {
                    <button
                        class="btn btn-sm btn-outline-secondary rounded-pill"
                        @onclick="() => QuitarIdioma(item)">
                        @item
                        <Icono Nombre="close" />
                    </button>
                }
                @if (precioFiltrado)
                {
                    <button class="btn btn-sm btn-outline-secondary rounded-pill" @onclick="QuitarPrecio">
                        S/ @minimoAplicado – S/ @maximoAplicado
                        <Icono Nombre="close" />
                    </button>
                }
                @if (Administracion && soloActivosAplicado)
                {
                    <button class="btn btn-sm btn-outline-secondary rounded-pill" @onclick="QuitarSoloActivos">
                        Solo activos
                        <Icono Nombre="close" />
                    </button>
                }
                @if (!HayFiltros)
                {
                    <span class="text-body-secondary">Ninguno</span>
                }
            </div>
        </div>
        <button class="btn btn-primary filter-action" @onclick="AplicarFiltros">Aplicar filtros</button>
        <button class="btn btn-secondary filter-action" @onclick="LimpiarFiltros">Limpiar filtros</button>
    </aside>
    <section class="catalog-results col-12 col-lg-9">
        <div class="results-heading d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="result-title d-flex flex-wrap align-items-baseline gap-3 flex-grow-1">
                <h1>@Titulo</h1>
                <span>@Resultados.Count libros</span>
            </div>
            @AccionesCabecera
            <label class="sort-label d-flex align-items-center gap-2">
                Ordenar por:
                <select class="form-select" aria-label="Ordenar libros" @bind="orden" @bind:after="CambiarOrden">
                    @foreach (var order in OpcionesOrden)
                    {
                        <option value="@order.Key">@order.Value</option>
                    }
                </select>
            </label>
        </div>
        @if (!string.IsNullOrWhiteSpace(Busqueda))
        {
            <p class="search-context">Resultados para “@Busqueda”</p>
        }
        @if (Resultados.Count == 0)
        {
            <div class="empty-state">
                <Icono Nombre="search" />
                <h2>No encontramos libros</h2>
                <p>Prueba con otros filtros o un título diferente.</p>
                <button class="btn btn-secondary" @onclick="LimpiarFiltros">Limpiar filtros</button>
            </div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-4">
                @foreach (var book in LibrosVisibles)
                {
                    <TarjetaLibro Libro="book" />
                }
            </div>
            <Paginacion Pagina="pagina" TotalPaginas="TotalPaginas" PaginaCambiada="CambiarPagina" />
        }
    </section>
</div>
