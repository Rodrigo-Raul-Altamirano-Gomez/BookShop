@page "/populares"
@page "/para-ti"
<PageTitle>@Titulo · BookShop</PageTitle>
<div class="container py-4">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page"><span>@Titulo</span></li>
        </ol>
    </nav>
    @if (Personal && Estado.Usuario is null)
    {
        <div class="empty-state">
            <Icono Nombre="user" />
            <h1>Lecturas para ti</h1>
            <p>Inicia sesión para consultar esta selección de ejemplo.</p>
            <button class="btn btn-primary" @onclick="AbrirAcceso">Iniciar sesión</button>
        </div>
    }
    else
    {
        <div class="results-heading d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="result-title d-flex flex-wrap align-items-baseline gap-3 flex-grow-1">
                <h1>@Titulo</h1>
                <span>@Libros.Count libros</span>
            </div>
            <label class="sort-label d-flex align-items-center gap-2">
                Ordenar por:
                <select
                    class="form-select"
                    @bind="orden"
                    @bind:after="CambiarOrden"
                    aria-label="Ordenar recomendaciones">
                    <option value="recomendados">Recomendados primero</option>
                    @foreach (var order in ExploradorCatalogo.OpcionesOrden.Where(o => o.Key != "vendidos"))
                    {
                        <option value="@order.Key">@order.Value</option>
                    }
                </select>
            </label>
        </div>
        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-4">
            @foreach (var book in LibrosVisibles)
            {
                <TarjetaLibro Libro="book" />
            }
        </div>
        <Paginacion Pagina="pagina" TotalPaginas="TotalPaginas" PaginaCambiada="CambiarPagina" />
    }
</div>
