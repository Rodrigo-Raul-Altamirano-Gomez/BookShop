@page "/populares"
@page "/para-ti"
<PageTitle>@Titulo · BookShop</PageTitle>
<div class="container py-4">
@if (personal && Sesion.Usuario is null)
{
    <h1>Para ti</h1>
    <p>Inicia sesión para consultar tus recomendaciones.</p>
    <button class="btn btn-primary" @onclick="Sesion.MostrarAcceso">Iniciar sesión</button>
}
else
{
    <Cargando EnCurso="cargando" Error="@error" AlReintentar="Abrir">
        @if (idConsulta is not null)
        {
            <ExploradorCatalogo @key="idConsulta" Titulo="@Titulo" IdConsulta="@idConsulta" OrdenFijo="true" />
        }
    </Cargando>
}
</div>
