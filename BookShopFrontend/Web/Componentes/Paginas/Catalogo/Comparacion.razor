@page "/comparacion"
<PageTitle>Comparar libros · BookShop</PageTitle>
<Cargando EnCurso="@cargando" Error="@errorCarga">
<div class="container comparison-page">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page"><span>Comparar libros</span></li>
        </ol>
    </nav>
    <h1>Comparar libros</h1>
    <a href="/catalogo" class="back-link">← Volver al catálogo</a>
    @if (PrimerLibro is null || SegundoLibro is null || PrimerLibro.Id == SegundoLibro.Id)
    {
        <div class="empty-state">
            <Icono Nombre="compare" />
            <h2>Elige dos lecturas para comparar</h2>
            <p>Abre el detalle de un libro y pulsa Comparar para empezar.</p>
            <a href="/catalogo" class="btn btn-primary">Explorar catálogo</a>
        </div>
    }
    else
    {
        <div class="comparison-cards row g-4">
            @foreach (var libro in LibrosComparados)
            {
                <div class="col-12 col-md-6">
                    <article class="card bookshop-panel comparison-card flex-row gap-4 p-4 h-100">
                        <img src="@libro.Portada" alt="@($"Portada de {libro.Titulo}")" />
                        <div class="d-flex flex-column align-items-stretch justify-content-center flex-grow-1">
                            <h2>@libro.Titulo</h2>
                            <p>@libro.Autor</p>
                            <a class="btn btn-primary" href="@($"/libros/{libro.Id}")">Ver libro</a>
                            <button
                                class="btn btn-link text-button"
                                @onclick="() => QuitarLibro(libro)">× Quitar</button>
                        </div>
                    </article>
                </div>
            }
        </div>
        <div class="comparison-table table-responsive card">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Característica</th>
                        <th>@PrimerLibro.Titulo</th>
                        <th>@SegundoLibro.Titulo</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th>Precio</th>
                        @foreach (var libro in LibrosComparados)
                        {
                            <td>
                                <strong>@Presentacion.Dinero(libro.Precio)</strong>
                                @if (libro.Descuento > 0)
                                {
                                    <del>@Presentacion.Dinero(libro.PrecioOriginal)</del>
                                    <span class="badge badge-bookshop discount-badge">-@libro.Descuento%</span>
                                }
                            </td>
                        }
                    </tr>
                    <tr>
                        <th>Valoración</th>
                        @foreach (var libro in LibrosComparados)
                        {
                            <td>
                                @if (CantidadResenas(libro) > 0)
                                {
                                    <span class="stars">★★★★★</span>
                                    <span>@PromedioResenas(libro).ToString("N1") / 5</span>
                                    <small>(@CantidadResenas(libro) reseñas)</small>
                                }
                                else
                                {
                                    <span class="text-body-secondary">Sin reseñas</span>
                                }
                            </td>
                        }
                    </tr>
                    <tr>
                        <th>Autor</th>
                        <td>@PrimerLibro.Autor</td>
                        <td>@SegundoLibro.Autor</td>
                    </tr>
                    <tr>
                        <th>Idioma</th>
                        <td>@PrimerLibro.Idioma</td>
                        <td>@SegundoLibro.Idioma</td>
                    </tr>
                    <tr>
                        <th>Categoría</th>
                        <td>@PrimerLibro.Categoria</td>
                        <td>@SegundoLibro.Categoria</td>
                    </tr>
                    <tr>
                        <th>Editorial</th>
                        <td>@PrimerLibro.Editorial</td>
                        <td>@SegundoLibro.Editorial</td>
                    </tr>
                    <tr>
                        <th>Año de edición</th>
                        <td>@PrimerLibro.Anio</td>
                        <td>@SegundoLibro.Anio</td>
                    </tr>
                    <tr>
                        <th>Páginas</th>
                        <td>@PrimerLibro.Paginas</td>
                        <td>@SegundoLibro.Paginas</td>
                    </tr>
                    <tr>
                        <th>Peso</th>
                        <td>@PrimerLibro.Peso</td>
                        <td>@SegundoLibro.Peso</td>
                    </tr>
                    <tr>
                        <th>Dimensiones</th>
                        <td>@PrimerLibro.Dimensiones</td>
                        <td>@SegundoLibro.Dimensiones</td>
                    </tr>
                    <tr>
                        <th>Saga</th>
                        <td>@TextoODefecto(PrimerLibro.Saga)</td>
                        <td>@TextoODefecto(SegundoLibro.Saga)</td>
                    </tr>
                    <tr>
                        <th>Tomo</th>
                        <td>@(PrimerLibro.Tomo?.ToString() ?? "—")</td>
                        <td>@(SegundoLibro.Tomo?.ToString() ?? "—")</td>
                    </tr>
                    <tr>
                        <th>Disponibilidad</th>
                        <td>@Disponibilidad(PrimerLibro)</td>
                        <td>@Disponibilidad(SegundoLibro)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>
</Cargando>
