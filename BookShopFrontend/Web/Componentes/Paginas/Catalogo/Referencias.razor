@page "/referencias/{Tipo}"
<PageTitle>@Titulo · BookShop</PageTitle>
<div class="container py-4">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page"><span>@Titulo</span></li>
        </ol>
    </nav>
    <div class="results-heading d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="result-title d-flex flex-wrap align-items-baseline gap-3">
            <h1>@Titulo</h1>
            <span>@totalResultados @Tipo</span>
        </div>
        <form class="reference-search input-group" @onsubmit="Buscar" @onsubmit:preventDefault>
            <input class="form-control" type="search"
                placeholder="Buscar por nombre" aria-label="Buscar por nombre"
                @bind="textoBusqueda" @bind:event="oninput" disabled="@cargando" />
            <button class="btn btn-primary" type="submit" disabled="@cargando">Buscar</button>
            @if (vista.Nombre.Length > 0)
            {
                <button class="btn btn-outline-secondary" type="button" aria-label="Quitar búsqueda"
                    @onclick="QuitarNombre" disabled="@cargando"><Icono Nombre="close" /></button>
            }
        </form>
        <label class="sort-label d-flex align-items-center gap-2">
            Ordenar por:
            <select class="form-select" aria-label="Ordenar referencias" @bind="vista.Orden" @bind:after="ActualizarResultados" disabled="@cargando">
                <option value="nombre">Nombre A-Z</option>
                <option value="reciente">Más recientes</option>
            </select>
        </label>
    </div>
    <Cargando EnCurso="@cargando" Error="@errorCarga" AlReintentar="Consultar">
        @if (Resultados.Count == 0)
        {
            <div class="empty-state">
                <Icono Nombre="book" />
                <h2>@(vista.Nombre.Length == 0 ? "No hay referencias disponibles" : "No encontramos coincidencias")</h2>
                @if (vista.Nombre.Length > 0)
                {
                    <p>Prueba con otro nombre o borra la búsqueda.</p>
                }
                <a href="/catalogo" class="btn btn-secondary">Explorar catálogo</a>
            </div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4 references-list">
                @foreach (var reference in Resultados)
                {
                    <TarjetaReferencia Referencia="reference" />
                }
            </div>
            <Paginacion Pagina="vista.Pagina" TotalPaginas="TotalPaginas" PaginaCambiada="CambiarPagina" />
        }
    </Cargando>
</div>
