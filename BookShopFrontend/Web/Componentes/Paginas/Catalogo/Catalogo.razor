@page "/catalogo"
<PageTitle>Catálogo · BookShop</PageTitle>
<div class="container py-4">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page"><span>Catálogo</span></li>
        </ol>
    </nav>
    <ExploradorCatalogo Titulo="@Titulo" Busqueda="@(Busqueda ?? "")"
        OrdenFijo="@(Criterio is "nuevos" or "vendidos")" OrdenInicial="@OrdenInicial" SoloNuevos="@(Criterio == "nuevos")" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? Busqueda { get; set; }

    [SupplyParameterFromQuery(Name = "criterio")]
    public string? Criterio { get; set; }
    private string Titulo
    {
        get
        {
            if (Criterio == "nuevos")
                return "Libros nuevos";
            if (Criterio == "vendidos")
                return "Más vendidos";
            return "Catálogo";
        }
    }

    private string OrdenInicial
    {
        get
        {
            if (Criterio == "vendidos")
                return "MAS_VENDIDOS";
            return "MAS_RECIENTES";
        }
    }
}
