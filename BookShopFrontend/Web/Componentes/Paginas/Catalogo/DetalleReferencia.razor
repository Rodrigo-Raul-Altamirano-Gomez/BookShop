@page "/referencias/{Tipo}/{Id:int}"
<PageTitle>@(Referencia?.Nombre ?? "Referencia") · BookShop</PageTitle>
<div class="container py-4">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="@($"/referencias/{Tipo}")">@Titulo</a></li>
            <li class="breadcrumb-item active" aria-current="page"><span>@Referencia?.Nombre</span></li>
        </ol>
    </nav>
    @if (Referencia is null)
    {
        <div class="empty-state">
            <h1>Referencia no encontrada</h1>
            <a href="/catalogo" class="btn btn-primary">Explorar catálogo</a>
        </div>
    }
    else
    {
        <section class="reference-banner row g-0">
            <div class="reference-picture col-12 col-md-6">
                <img
                    onerror="this.onerror=null;this.src='/images/reference-placeholder.svg'"
                    src="@Referencia.Imagen"
                    alt="@Referencia.Nombre"
                    />
                @if (Estado.EsAdministrador)
                {
                    <div class="image-actions d-flex gap-2">
                        <label class="btn btn-outline-secondary icon-button" title="Cambiar imagen">
                            <Icono Nombre="edit" />
                            <InputFile class="form-control"
                                OnChange="CambiarImagen"
                                disabled="@cargandoImagen"
                                accept="image/png,image/jpeg"
                                />
                        </label>
                        <button
                            class="btn btn-outline-secondary icon-button"
                            title="Quitar imagen"
                            disabled="@cargandoImagen"
                            @onclick="QuitarImagen">
                            <Icono Nombre="trash" />
                        </button>
                    </div>
                }
            </div>
            <div class="reference-copy col-12 col-md-6 d-flex flex-column p-4
                align-items-start justify-content-center">
                <h1>@Referencia.Nombre</h1>
                <p>@Referencia.Descripcion</p>
                <button class="btn btn-secondary" @onclick="AlternarSeguimiento">
                    <Icono Nombre="follow" />
                    @(Seguimientos ? "Dejar de seguir" : $"Seguir {Singular}")
                </button>
                @if (Estado.EsAdministrador)
                {
                    <GestionReferencia Referencia="Referencia" />
                }
            </div>
        </section>
        <ExploradorCatalogo
            Libros="Libros"
            Titulo="@($"Libros de {Referencia.Nombre}")"
            TipoAmbito="@Tipo"
            Administracion="Estado.EsAdministrador"
            />
    }
</div>
