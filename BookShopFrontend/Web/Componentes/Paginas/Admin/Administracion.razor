@page "/administracion"
@implements IDisposable
<PageTitle>Administración · BookShop</PageTitle>
<div class="container py-4">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><span>Cuenta</span></li>
            <li class="breadcrumb-item active" aria-current="page"><span>Administración</span></li>
        </ol>
    </nav>
    <h1 class="page-heading d-flex flex-wrap align-items-center justify-content-between gap-3">Administración</h1>
    @if (!Estado.EsAdministrador)
    {
        <div class="empty-state">
            <Icono Nombre="user" />
            <h2>Acceso administrativo</h2>
            <p>Inicia sesión con la cuenta de demostración demo@@admin.bookshop.</p>
            <button class="btn btn-primary" @onclick="Estado.MostrarAcceso">Iniciar sesión</button>
        </div>
    }
    else
    {
        <h2
            class="section-heading d-flex flex-wrap align-items-center justify-content-between gap-3">
            Gestión del catálogo
        </h2>
        <div class="row g-4 row-cols-1 row-cols-sm-2 row-cols-xl-4">
            <div class="col">
                <a href="/administracion/libros" class="admin-card card h-100 w-100 p-4 text-start">
                    <span class="admin-icon d-flex align-items-center justify-content-center">
                        <Icono Nombre="book" />
                    </span>
                    <h3>Libros</h3>
                    <p>Consulta, registra y administra los libros.</p>
                </a>
            </div>
            <div class="col">
                <a href="/administracion/autores" class="admin-card card h-100 w-100 p-4 text-start">
                    <span class="admin-icon d-flex align-items-center justify-content-center">
                        <Icono Nombre="edit" />
                    </span>
                    <h3>Autores</h3>
                    <p>Gestiona los autores del catálogo.</p>
                </a>
            </div>
            <div class="col">
                <a href="/administracion/categorias" class="admin-card card h-100 w-100 p-4 text-start">
                    <span class="admin-icon d-flex align-items-center justify-content-center">
                        <Icono Nombre="grid" />
                    </span>
                    <h3>Categorías</h3>
                    <p>Organiza y administra las categorías.</p>
                </a>
            </div>
            <div class="col">
                <a href="/administracion/editoriales" class="admin-card card h-100 w-100 p-4 text-start">
                    <span class="admin-icon d-flex align-items-center justify-content-center">
                        <Icono Nombre="building" />
                    </span>
                    <h3>Editoriales</h3>
                    <p>Gestiona las editoriales del catálogo.</p>
                </a>
            </div>
        </div>
        <h2
            class="section-heading general-title d-flex flex-wrap gap-3
                align-items-center justify-content-between">
            Administración general
        </h2>
        <div class="row g-4 row-cols-1 row-cols-sm-2 row-cols-lg-3">
            <div class="col">
                <a href="/moderacion" class="admin-card card h-100 w-100 p-4 text-start">
                    <span class="admin-icon d-flex align-items-center justify-content-center">
                        <Icono Nombre="flag" />
                    </span>
                    <h3>Moderación</h3>
                    <p>Revisa solicitudes de devolución y reportes de reseñas.</p>
                </a>
            </div>
            <div class="col">
                <button class="admin-card card h-100 w-100 p-4 text-start" @onclick="AbrirReportes">
                    <span class="admin-icon d-flex align-items-center justify-content-center">
                        <Icono Nombre="report" />
                    </span>
                    <h3>Reportes</h3>
                    <p>Consulta reportes de libros y usuarios.</p>
                </button>
            </div>
            <div class="col">
                <button class="admin-card card h-100 w-100 p-4 text-start" @onclick="AbrirConfiguracion">
                    <span class="admin-icon d-flex align-items-center justify-content-center">
                        <Icono Nombre="settings" />
                    </span>
                    <h3>Configuración</h3>
                    <p>Ajusta envío, devoluciones y cupones.</p>
                </button>
            </div>
        </div>
    }
</div>
@if (ConfiguracionAbierta)
{
    <Modal Titulo="Configuración" AlCerrar="CerrarConfiguracion">
        <form @onsubmit="GuardarConfiguracion" @onsubmit:preventDefault>
            <div class="row g-3">
                <label class="field form-label d-block col-12 col-md-6">
                    Porcentaje de envío (%) *
                    <input class="form-control"
                        type="number"
                        min="0"
                        max="100"
                        step="0.01"
                        @bind="BorradorConfiguracion.PorcentajeEnvio"
                        @bind:event="oninput"
                        required
                        />
                </label>
                <label class="field form-label d-block col-12 col-md-6">
                    Plazo de devolución (días) *
                    <input class="form-control"
                        type="number"
                        min="1"
                        @bind="BorradorConfiguracion.DiasDevolucion"
                        @bind:event="oninput"
                        required
                        />
                </label>
                <label class="field form-label d-block col-12 col-md-6">
                    Máximo de intentos de devolución *
                    <input class="form-control"
                        type="number"
                        min="1"
                        @bind="BorradorConfiguracion.IntentosDevolucion"
                        @bind:event="oninput"
                        required
                        />
                </label>
                <label class="field form-label d-block col-12 col-md-6">
                    Pedidos entregados por cupón *
                    <input class="form-control"
                        type="number"
                        min="1"
                        @bind="BorradorConfiguracion.PedidosEntregados"
                        @bind:event="oninput"
                        required
                        />
                </label>
                <label class="field form-label d-block col-12 col-md-6">
                    Porcentaje del cupón (%) *
                    <input class="form-control"
                        type="number"
                        min="1"
                        max="100"
                        step="0.01"
                        @bind="BorradorConfiguracion.PorcentajeCupon"
                        @bind:event="oninput"
                        required
                        />
                </label>
                <label class="field form-label d-block col-12 col-md-6">
                    Monto mínimo del cupón (S/) *
                    <input class="form-control"
                        type="number"
                        min="0"
                        step="0.01"
                        @bind="BorradorConfiguracion.MontoMinimoCupon"
                        @bind:event="oninput"
                        required
                        />
                </label>
                <label class="field form-label d-block col-12 col-md-6">
                    Duración del cupón (días) *
                    <input class="form-control"
                        type="number"
                        min="1"
                        @bind="BorradorConfiguracion.DiasCupon"
                        @bind:event="oninput"
                        required
                        />
                </label>
            </div>
            @if (ErrorFormulario.Length > 0)
            {
                <p class="alert alert-danger py-2" role="alert">@ErrorFormulario</p>
            }
            <div class="modal-footer px-0 pb-0 d-flex flex-wrap justify-content-end gap-2 mt-4">
                <button type="button" class="btn btn-secondary" @onclick="CerrarConfiguracion">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
            </div>
        </form>
    </Modal>
}
@if (ReportesAbiertos)
{
    <Modal Titulo="Reportes" AlCerrar="CerrarReportes">
        <div class="nav nav-tabs bookshop-tabs">
            <button
                class="nav-link bookshop-tab @(PestanaReporte == "Libros" ? "active" : "")"
                @onclick="ElegirLibros">
                Libros
            </button>
            <button
                class="nav-link bookshop-tab @(PestanaReporte == "Usuarios" ? "active" : "")"
                @onclick="ElegirUsuarios">
                Usuarios
            </button>
        </div>
        <form @onsubmit="GenerarReporte" @onsubmit:preventDefault>
            <div class="row g-3">
                @if (PestanaReporte == "Libros")
                {
                    <label class="field form-label d-block col-12 col-md-6">
                        Inicio del período *
                        <input class="form-control" type="date" @bind="InicioReporte" required />
                    </label>
                    <label class="field form-label d-block col-12 col-md-6">
                        Fin del período *
                        <input class="form-control" type="date" @bind="FinReporte" required />
                    </label>
                }
                else
                {
                    <label class="field form-label d-block col-12 col-md-6">
                        Mes *
                        <select class="form-select" @bind="MesReporte">
                            @for (var Mes = 1; Mes <= 12; Mes++)
                            {
                                <option value="@Mes">@NombresMeses[Mes - 1]</option>
                            }
                        </select>
                    </label>
                    <label class="field form-label d-block col-12 col-md-6">
                        Año *
                        <input
                            class="form-control"
                            type="number"
                            min="1"
                            @bind="AnioReporte"
                            @bind:event="oninput" required />
                    </label>
                }
                <label class="field form-label d-block col-12 col-md-6">
                    Cantidad máxima
                    <input
                        class="form-control"
                        type="number"
                        min="1"
                        @bind="LimiteReporte"
                        @bind:event="oninput" />
                </label>
            </div>
            @if (ErrorFormulario.Length > 0)
            {
                <p class="alert alert-danger py-2" role="alert">@ErrorFormulario</p>
            }
            <div class="modal-footer px-0 pb-0 d-flex flex-wrap justify-content-end gap-2 mt-4">
                <button type="button" class="btn btn-secondary" @onclick="CerrarReportes">Cancelar</button>
                <button type="submit" class="btn btn-primary">
                    <Icono Nombre="report" />
                    Generar
                </button>
            </div>
        </form>
    </Modal>
}
@if (VistaReporte)
{
    <Modal
        Titulo="@($"Reporte de {PestanaReporte.ToLower()} · vista previa")"
        AlCerrar="CerrarVistaReporte"
        Amplio="true">
        <div class="report-sheet">
            <div class="report-brand d-flex align-items-center gap-2">
                <Icono Nombre="book" />
                <strong>BookShop</strong>
                <span>Más que libros, grandes historias.</span>
            </div>
            <h2>@(PestanaReporte == "Libros" ? "Reporte de ventas de libros" : "Reporte mensual de usuarios")</h2>
            <p>
                @(PestanaReporte == "Libros" ? $"Período: {InicioReporte:dd/MM/yyyy} — {FinReporte:dd/MM/yyyy}" :
                $"Período: {NombresMeses[MesReporte - 1]} {AnioReporte}")
            </p>
            <p class="text-body-secondary">
                Generado: 07/10/2026 · Máximo solicitado: @(LimiteReporte?.ToString() ?? "Sin límite") · Cantidad
                obtenida: @(PestanaReporte == "Libros" ? LibrosReporte.Count() : UsuariosReporte.Count())
            </p>
            <div class="table-responsive">
                @if (PestanaReporte == "Libros")
                {
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Libro</th>
                                <th>Categoría</th>
                                <th>Autor</th>
                                <th>Editorial</th>
                                <th>Cantidad vendida</th>
                                <th>Importe de ventas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var Libro in LibrosReporte)
                            {
                                <tr>
                                    <td>@Libro.Titulo</td>
                                    <td>@Libro.Categoria</td>
                                    <td>@Libro.Autor</td>
                                    <td>@Libro.Editorial</td>
                                    <td>12</td>
                                    <td>@EstadoDemostracion.Dinero(Libro.Precio * 12)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Usuario</th>
                                <th>Activo</th>
                                <th>Gasto</th>
                                <th>Tiempo</th>
                                <th>Categoría</th>
                                <th>Autor</th>
                                <th>Editorial</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var Usuario in UsuariosReporte)
                            {
                                <tr>
                                    <td>
                                        @Usuario.Nombre
                                        <small>@Usuario.Correo</small>
                                    </td>
                                    <td>@Usuario.Activo</td>
                                    <td>@Usuario.Gasto</td>
                                    <td>@Usuario.Tiempo</td>
                                    <td>@Usuario.Categoria</td>
                                    <td>@Usuario.Autor</td>
                                    <td>@Usuario.Editorial</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="report-foot">Vista previa con datos de ejemplo · Página 1</div>
        </div>
        <p class="text-body-secondary">La generación de PDF se conectará en la fase de integración.</p>
    </Modal>
}
