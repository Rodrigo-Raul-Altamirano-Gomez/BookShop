@page "/administracion/libros"
@page "/administracion/autores"
@page "/administracion/categorias"
@page "/administracion/editoriales"
@using Web.Componentes.Paginas.Catalogo
@implements IDisposable
<PageTitle>@Titulo · Administración · BookShop</PageTitle>
<div class="container py-4">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="/administracion">Administración</a></li>
            <li class="breadcrumb-item active" aria-current="page"><span>@Titulo</span></li>
        </ol>
    </nav>
    @if (!Estado.EsAdministrador)
    {
        <div class="empty-state">
            <Icono Nombre="user" />
            <h1>Acceso administrativo</h1>
            <p>Inicia sesión con demo@@admin.bookshop para recorrer estas pantallas.</p>
            <button class="btn btn-primary" @onclick="Estado.MostrarAcceso">Iniciar sesión</button>
        </div>
    }
    else if (Tipo == "libros")
    {
        <ExploradorCatalogo Libros="Estado.Libros" Titulo="Libros" Administracion="true">
            <AccionesCabecera>
                <button class="btn btn-primary" @onclick="AbrirAlta">
                    <Icono Nombre="plus" />
                    Añadir libro
                </button>
            </AccionesCabecera>
        </ExploradorCatalogo>
    }
    else
    {
        <div class="row g-4">
            <aside class="filters col-12 col-lg-3">
                <h2>Filtros</h2>
                <div class="filter-group">
                    <label class="form-check d-flex align-items-center gap-2 ps-0">
                        <input class="form-check-input m-0" type="checkbox" @bind="BorradorSoloActivos" />
                        Solo activos
                    </label>
                </div>
                <div class="filter-group">
                    <h3>Filtros activos</h3>
                    <div class="d-flex flex-wrap gap-2">
                        @if (SoloActivos)
                        {
                            <button
                                class="btn btn-sm btn-outline-secondary rounded-pill"
                                @onclick="QuitarSoloActivos">
                                Solo activos
                                <Icono Nombre="close" />
                            </button>
                        }
                        else
                        {
                            <span class="text-body-secondary">Sin filtros</span>
                        }
                    </div>
                </div>
                <button class="btn btn-primary" @onclick="Aplicar">Aplicar filtros</button>
                <button class="btn btn-secondary" @onclick="Limpiar">Limpiar filtros</button>
            </aside>
            <div class="col-12 col-lg-9">
                <div class="results-heading d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <h1>@Titulo</h1>
                        <span class="text-body-secondary">@Filtrados.Count() @Titulo.ToLower()</span>
                    </div>
                    <div class="list-actions d-flex flex-wrap align-items-center gap-2">
                        <select
                            class="form-select"
                            aria-label="Ordenar"
                            @bind="Orden"
                            @bind:after="ReiniciarPagina">
                            <option value="Nombre">Nombre A-Z</option>
                            <option value="recent">Más recientes</option>
                        </select>
                        <button class="btn btn-primary" @onclick="AbrirAlta">
                            <Icono Nombre="plus" />
                            Añadir @Singular
                        </button>
                    </div>
                </div>
                @if (!Filtrados.Any())
                {
                    <div class="empty-state">
                        <Icono Nombre="search" />
                        <h2>No hay @Tipo</h2>
                        <p>Prueba con otros filtros o añade una referencia.</p>
                    </div>
                }
                else
                {
                    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
                        @foreach (var Referencia in ElementosPagina)
                        {
                            <TarjetaReferencia Referencia="Referencia" />
                        }
                    </div>
                    <Paginacion Pagina="Pagina" TotalPaginas="TotalPaginas" PaginaCambiada="CambiarPagina" />
                }
            </div>
        </div>
    }
</div>
@if (MostrarLibro)
{
    <RegistroLibro AlCerrar="CerrarLibro" />
}
@if (MostrarReferencia)
{
    <Modal Titulo="@($"Añadir {Singular}")" AlCerrar="CerrarReferencia">
        <form @onsubmit="AgregarReferencia" @onsubmit:preventDefault>
            <div class="image-preview">
                <img src="@ImagenReferencia" alt="Vista previa de la imagen" />
                <div class="image-buttons d-flex gap-2">
                    <label class="btn btn-outline-secondary icon-button file-label" title="Elegir imagen">
                        <Icono Nombre="edit" />
                        <InputFile
                            class="form-control" OnChange="LeerImagenReferencia"
                            accept="image/jpeg,image/png" />
                    </label>
                    <button
                        type="button"
                        class="btn btn-outline-secondary icon-button"
                        title="Quitar imagen"
                        @onclick="QuitarImagenReferencia">
                        <Icono Nombre="trash" />
                    </button>
                </div>
            </div>
            <label class="field form-label d-block">
                Nombre *
                <input class="form-control" @bind="NombreReferencia" @bind:event="oninput" required />
            </label>
            <label class="field form-label d-block">
                @(Tipo == "autores" ? "Biografía" : "Descripción") *
                <textarea
                    class="form-control" rows="6"
                    @bind="DescripcionReferencia"
                    @bind:event="oninput" required>
                </textarea>
            </label>
            @if (ErrorFormulario.Length > 0)
            {
                <p class="alert alert-danger py-2" role="alert">@ErrorFormulario</p>
            }
            <div class="modal-footer px-0 pb-0 d-flex flex-wrap justify-content-end gap-2 mt-4">
                <button type="button" class="btn btn-secondary" @onclick="CerrarReferencia">Cancelar</button>
                <button type="submit" class="btn btn-primary">Añadir @Singular</button>
            </div>
        </form>
    </Modal>
}
