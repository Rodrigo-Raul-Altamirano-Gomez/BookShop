<Modal Titulo="Registrar libro" AlCerrar="AlCerrar" Amplio="true">
    <div class="registro-formulario">
        <div class="cover-preview">
            <img src="@Borrador.Portada" alt="Vista previa de la portada" />
            <div class="image-buttons d-flex gap-2">
                <label class="btn btn-outline-secondary icon-button file-label" title="Elegir portada">
                    <Icono Nombre="edit" />
                    <InputFile class="form-control" OnChange="LeerPortada" accept="image/jpeg,image/png" />
                </label>
                <button
                    type="button"
                    class="btn btn-outline-secondary icon-button"
                    title="Quitar portada"
                    @onclick="QuitarPortada">
                    <Icono Nombre="trash" />
                </button>
            </div>
        </div>
        <div class="row g-3">
            <label class="field form-label d-block col-12">
                Título *
                <input class="form-control" @bind="Borrador.Titulo" @bind:event="oninput" required />
            </label>
            <label class="field form-label d-block col-12">
                Idioma *
                <input class="form-control" @bind="Borrador.Idioma" @bind:event="oninput" required />
            </label>
            <label class="field form-label d-block col-12">
                Sinopsis *
                <textarea class="form-control" rows="5" @bind="Borrador.Sinopsis" @bind:event="oninput" required>
                </textarea>
            </label>
            @foreach (var TipoReferencia in TiposReferencias)
            {
                <div class="reference-picker col-12">
                    <label class="field form-label d-block">
                        @EtiquetaReferencia(TipoReferencia) *
                        <span class="reference-search d-flex gap-2">
                            <input class="form-control"
                                value="@Busquedas[TipoReferencia]"
                                @oninput="e => CambiarBusqueda(TipoReferencia, e)"
                                @onkeydown="e => BuscarConEnter(TipoReferencia, e)"
                                placeholder="Buscar por nombre"
                                />
                            <button
                                type="button"
                                class="btn btn-secondary"
                                @onclick="() => Buscar(TipoReferencia)">
                                <Icono Nombre="search" />
                                Buscar
                            </button>
                        </span>
                    </label>
                    <div class="reference-options d-flex flex-wrap gap-2 overflow-auto">
                        @foreach (var Referencia in Opciones(TipoReferencia))
                        {
                            <button
                                type="button"
                                class="reference-option btn btn-outline-secondary d-flex align-items-center gap-2
                                    @(Selecciones[TipoReferencia] == Referencia.Nombre ?
                                    "selected" : "")"
                                @onclick="() => Elegir(Referencia)">
                                <span class="selection-dot">
                                </span>
                                @Referencia.Nombre
                            </button>
                        }
                        @if (!Opciones(TipoReferencia).Any())
                        {
                            <span class="text-body-secondary">No hay resultados con ese nombre.</span>
                        }
                    </div>
                </div>
            }
            <label class="field form-label d-block col-12 col-md-6">
                ISBN *
                <input class="form-control" @bind="Borrador.ISBN" @bind:event="oninput" required />
            </label>
            <label class="field form-label d-block col-12 col-md-6">
                Proveedor *
                <input class="form-control" @bind="Borrador.Proveedor" @bind:event="oninput" required />
            </label>
            <label class="field form-label d-block col-12 col-md-6">
                Año de edición *
                <input
                    class="form-control"
                    type="number"
                    min="1"
                    @bind="Borrador.Anio"
                    @bind:event="oninput" required />
            </label>
            <label class="field form-label d-block col-12 col-md-6">
                Número de páginas *
                <input
                    class="form-control"
                    type="number"
                    min="1"
                    @bind="Borrador.Paginas"
                    @bind:event="oninput" required />
            </label>
            <label class="field form-label d-block col-12 col-md-6">
                Precio base (S/) *
                <input class="form-control"
                    type="number"
                    min="0.01"
                    step="0.01"
                    @bind="Borrador.PrecioOriginal"
                    @bind:event="oninput"
                    required
                    />
            </label>
            <label class="field form-label d-block col-12 col-md-6">
                Stock inicial *
                <input
                    class="form-control"
                    type="number"
                    min="0"
                    @bind="Borrador.Stock"
                    @bind:event="oninput" required />
            </label>
            <label class="field form-label d-block col-12 col-md-6">
                Peso (kg)
                <input class="form-control" @bind="Peso" @bind:event="oninput" />
            </label>
            <label class="field form-label d-block col-12 col-md-6">
                Alto (cm)
                <input class="form-control" @bind="Alto" @bind:event="oninput" />
            </label>
            <label class="field form-label d-block col-12 col-md-6">
                Ancho (cm)
                <input class="form-control" @bind="Ancho" @bind:event="oninput" />
            </label>
            <label class="field form-label d-block col-12 col-md-6">
                Saga
                <input class="form-control" @bind="Borrador.Saga" @bind:event="oninput" />
            </label>
            <label class="field form-label d-block col-12 col-md-6">
                Tomo
                <input class="form-control" type="number" min="1" @bind="Borrador.Tomo" @bind:event="oninput" />
            </label>
        </div>
        @if (ErrorFormulario.Length > 0)
        {
            <p class="alert alert-danger py-2" role="alert">@ErrorFormulario</p>
        }
        <div class="modal-footer px-0 pb-0 d-flex flex-wrap justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-secondary" @onclick="AlCerrar">Cancelar</button>
            <button type="button" class="btn btn-primary" @onclick="Registrar">Registrar libro</button>
        </div>
    </div>
</Modal>
