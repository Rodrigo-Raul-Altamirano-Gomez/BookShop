@page "/moderacion"
@implements IDisposable
<PageTitle>Moderación · BookShop</PageTitle>
<div class="container py-4">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="/administracion">Administración</a></li>
            <li class="breadcrumb-item active" aria-current="page"><span>Moderación</span></li>
        </ol>
    </nav>
    @if (!Estado.EsAdministrador)
    {
        <div class="empty-state">
            <Icono Nombre="user" />
            <h1>Acceso administrativo</h1>
            <p>Inicia sesión con demo@@admin.bookshop para recorrer estas pantallas.</p>
            <button class="btn btn-primary" @onclick="Estado.MostrarAcceso">Iniciar sesión</button>
        </div>
    }
    else
    {
        <div class="row g-4">
            <aside class="filters col-12 col-lg-3">
                <h2>Filtros</h2>
                <div class="filter-group">
                    <h3>Estado de la solicitud</h3>
                    @foreach (var EstadoSolicitud in EstadosSolicitud)
                    {
                        <label class="status-check form-check d-flex align-items-center gap-2">
                            <input class="form-check-input"
                                type="checkbox"
                                checked="@BorradorEstados.Contains(EstadoSolicitud)"
                                @onchange="() => AlternarEstado(EstadoSolicitud)"
                                />
                            @EstadoSolicitud
                        </label>
                    }
                </div>
                <div class="filter-group">
                    <h3>Filtros activos</h3>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var EstadoSolicitud in EstadosAplicados)
                        {
                            <button
                                class="btn btn-sm btn-outline-secondary rounded-pill"
                                @onclick="() => QuitarEstado(EstadoSolicitud)">
                                @EstadoSolicitud
                                <Icono Nombre="close" />
                            </button>
                        }
                        @if (EstadosAplicados.Count == 0)
                        {
                            <span class="text-body-secondary">Sin filtros</span>
                        }
                    </div>
                </div>
                <button class="btn btn-primary" @onclick="Aplicar">Aplicar filtros</button>
                <button class="btn btn-secondary" @onclick="Limpiar">Limpiar filtros</button>
            </aside>
            <div class="col-12 col-lg-9">
                <div class="results-heading d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <h1>Moderación</h1>
                        <span class="text-body-secondary">@Filtrados.Count() @Pestana.ToLower()</span>
                    </div>
                    @if (Pestana == "Reportes")
                    {
                        <a class="btn btn-secondary" href="/todas-resenas">Ver todas las reseñas</a>
                    }
                </div>
                <div class="nav nav-tabs bookshop-tabs">
                    <button
                        class="nav-link bookshop-tab @(Pestana == "Devoluciones" ? "active" : "")"
                        @onclick="ElegirDevoluciones">
                        Devoluciones
                    </button>
                    <button
                        class="nav-link bookshop-tab @(Pestana == "Reportes" ? "active" : "")"
                        @onclick="ElegirReportes">
                        Reportes
                    </button>
                </div>
                @if (!Filtrados.Any())
                {
                    <div class="empty-state">
                        <Icono Nombre="flag" />
                        <h2>No hay solicitudes</h2>
                        <p>Prueba con otros estados para ver los ejemplos.</p>
                    </div>
                }
                else
                {
                    <div class="request-list d-grid gap-3">
                        @foreach (var Solicitud in ElementosPagina)
                        {
                            <article class="request-card card flex-sm-row justify-content-between gap-4 p-4">
                                <div>
                                    <h3>Solicitud N.° @Solicitud.Id</h3>
                                    <p class="text-body-secondary">
                                        @Solicitud.FechaCreacion.ToString("dd/MM/yyyy, HH:mm")
                                    </p>
                                    <p>
                                        <strong>Solicitante:</strong>
                                        @Solicitud.Usuario
                                    </p>
                                    <p>
                                        <strong>Motivo:</strong>
                                        @Solicitud.Motivo
                                    </p>
                                    <p class="text-body-secondary">
                                        @(Solicitud.Tipo == "Devoluciones" ? "Pedido" : "Reseña") N.°
                                        @Solicitud.IdReferencia
                                    </p>
                                </div>
                                <div
                                    class="request-actions d-flex flex-column gap-3
                                        justify-content-between align-items-end">
                                    <span
                                        class="badge bookshop-status @ClaseEstado(Solicitud.Estado)">
                                        @Solicitud.Estado
                                    </span>
                                    <button class="btn btn-secondary" @onclick="() => Abrir(Solicitud)">
                                        Ver solicitud
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                    <Paginacion Pagina="Pagina" TotalPaginas="TotalPaginas" PaginaCambiada="CambiarPagina" />
                }
            </div>
        </div>
    }
</div>
@if (SolicitudSeleccionada is not null)
{
    <Modal
        Titulo="@($"{(SolicitudSeleccionada.Tipo == "Devoluciones"
            ? "Solicitud de devolución"
            : "Reporte de reseña")} N.° {SolicitudSeleccionada.Id}")"
        AlCerrar="Cerrar"
        Amplio="true">
        <div class="request-summary">
            <span
                class="badge bookshop-status @ClaseEstado(SolicitudSeleccionada.Estado)">
                @SolicitudSeleccionada.Estado
            </span>
            <p class="text-body-secondary">
                Fecha de solicitud: @SolicitudSeleccionada.FechaCreacion.ToString("dd/MM/yyyy, HH:mm")
            </p>
        </div>
        <div class="request-details row g-4 border-top pt-4">
            <div class="col-12 col-md-6">
                <span class="text-body-secondary">Solicitante</span>
                <h3>@SolicitudSeleccionada.Usuario</h3>
            </div>
            <div class="col-12 col-md-6">
                <span class="text-body-secondary">Motivo</span>
                <p>@SolicitudSeleccionada.Motivo</p>
            </div>
        </div>
        <div class="request-comment">
            <span class="text-body-secondary">Comentario adicional</span>
            <p>
                @(string.IsNullOrWhiteSpace(SolicitudSeleccionada.Comentario) ? "Sin comentario adicional" :
                SolicitudSeleccionada.Comentario)
            </p>
        </div>
        @if (SolicitudSeleccionada.Tipo == "Devoluciones")
        {
            @if (PedidoRelacionado is { } Pedido)
            {
                <div class="reference-box card p-4">
                    <h3>Pedido N.° @Pedido.Id</h3>
                    <div class="order-summary row g-3">
                        <span class="col-6 col-lg-3">
                            <small>Fecha de pago</small>
                            @Pedido.FechaPago.ToString("dd/MM/yyyy, HH:mm")
                        </span>
                        <span class="col-6 col-lg-3">
                            <small>Cantidad de libros</small>
                            @Pedido.Lineas.Sum(l => l.Cantidad)
                        </span>
                        <span class="col-6 col-lg-3">
                            <small>Total pagado</small>
                            <strong>@EstadoDemostracion.Dinero(Pedido.Total)</strong>
                        </span>
                        <span class="col-6 col-lg-3">
                            <small>Estado</small>
                            @Pedido.Estado
                        </span>
                    </div>
                </div>
            }
            else
            {
                <div class="reference-box card p-4">
                    <h3>Pedido N.° @SolicitudSeleccionada.IdReferencia</h3>
                    <p class="text-body-secondary">La referencia no está disponible en estos datos de ejemplo.</p>
                </div>
            }
        }
        else
        {
            @if (ResenaRelacionada is { } Resena)
            {
                <div class="reference-box card p-4">
                    <h3>Reseña N.° @Resena.Id</h3>
                    <div
                        class="review-reference d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <span>
                            Autor:
                            <strong>@Resena.Usuario</strong>
                            <br />
                            Libro:
                            <strong>@Estado.BuscarLibro(Resena.IdLibro)?.Titulo</strong>
                        </span>
                        <span class="badge bookshop-status @(Resena.Activo ? "status-green" : "")">
                            @(Resena.Activo ? "Activa" : "Inactiva")
                        </span>
                    </div>
                </div>
                <div class="comparison-content row g-3">
                    <div class="col-12 col-md-6">
                        <div class="reference-box card h-100 p-4">
                            <h3>Contenido original</h3>
                            <span class="stars">@MostrarEstrellas(SolicitudSeleccionada.PuntuacionOriginal)</span>
                            <p>@SolicitudSeleccionada.ComentarioOriginal</p>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="reference-box card h-100 p-4">
                            <h3>Contenido actual</h3>
                            <span class="stars">@MostrarEstrellas(Resena.Puntuacion)</span>
                            <p>@Resena.Comentario</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="reference-box card p-4">
                    <h3>Reseña N.° @SolicitudSeleccionada.IdReferencia</h3>
                    <p class="text-body-secondary">La referencia no está disponible en estos datos de ejemplo.</p>
                </div>
            }
        }
        @if (SolicitudSeleccionada.Estado == "Pendiente")
        {
            <div class="resolution-actions d-flex flex-wrap justify-content-between gap-3 border-top pt-4">
                @if (SolicitudSeleccionada.Tipo == "Reportes")
                {
                    <button class="btn btn-secondary" @onclick="ResolverCerrada">Cerrar solicitud</button>
                }
                <div class="d-flex flex-wrap gap-2 ms-auto">
                    <button class="btn btn-danger" @onclick="ResolverRechazada">Rechazar</button>
                    <button class="btn btn-primary" @onclick="ResolverAceptada">
                        Aceptar @(SolicitudSeleccionada.Tipo == "Devoluciones" ? "devolución" : "reporte")
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="resolution-result alert alert-success d-flex align-items-center gap-3">
                <Icono Nombre="check" />
                <div>
                    <strong>Solicitud @SolicitudSeleccionada.Estado.ToLower()</strong>
                    <p class="text-body-secondary">
                        Fecha de resolución:
                        @SolicitudSeleccionada.FechaResolucion?.ToString("dd/MM/yyyy, HH:mm")
                    </p>
                </div>
            </div>
        }
    </Modal>
}
