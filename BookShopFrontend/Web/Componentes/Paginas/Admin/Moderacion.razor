@page "/moderacion"
@implements IDisposable
<PageTitle>Moderación · BookShop</PageTitle>
<div class="container">
    <nav class="breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/administracion">Administración</a>
        <span>/</span>
        <span>Moderación</span>
    </nav>
    @if (!Estado.EsAdministrador)
    {
        <div class="empty-state">
            <Icono Nombre="user" />
            <h1>Acceso administrativo</h1>
            <p>Inicia sesión con demo@@admin.bookshop para recorrer estas pantallas.</p>
            <button class="btn btn-primary" @onclick="Estado.MostrarAcceso">Iniciar sesión</button>
        </div>
    }
    else
    {
        <div class="catalog-layout">
            <aside class="filters">
                <h2>Filtros</h2>
                <div class="filter-group">
                    <h3>Estado de la solicitud</h3>
                    @foreach (var EstadoSolicitud in EstadosSolicitud)
                    {
                        <label class="status-check">
                            <input
                                type="checkbox"
                                checked="@BorradorEstados.Contains(EstadoSolicitud)"
                                @onchange="() => AlternarEstado(EstadoSolicitud)"
                                />
                            @EstadoSolicitud
                        </label>
                    }
                </div>
                <div class="filter-group">
                    <h3>Filtros activos</h3>
                    <div class="chips">
                        @foreach (var EstadoSolicitud in EstadosAplicados)
                        {
                            <button class="chip" @onclick="() => QuitarEstado(EstadoSolicitud)">
                                @EstadoSolicitud
                                <Icono Nombre="close" />
                            </button>
                        }
                        @if (EstadosAplicados.Count == 0)
                        {
                            <span class="muted">Sin filtros</span>
                        }
                    </div>
                </div>
                <button class="btn btn-primary" @onclick="Aplicar">Aplicar filtros</button>
                <button class="btn btn-secondary" @onclick="Limpiar">Limpiar filtros</button>
            </aside>
            <div>
                <div class="results-heading">
                    <div>
                        <h1>Moderación</h1>
                        <span class="muted">@Filtrados.Count() @Pestana.ToLower()</span>
                    </div>
                    @if (Pestana == "Reportes")
                    {
                        <a class="btn btn-secondary" href="/todas-resenas">Ver todas las reseñas</a>
                    }
                </div>
                <div class="tabs">
                    <button class="tab @(Pestana == "Devoluciones" ? "active" : "")" @onclick="ElegirDevoluciones">
                        Devoluciones
                    </button>
                    <button class="tab @(Pestana == "Reportes" ? "active" : "")" @onclick="ElegirReportes">
                        Reportes
                    </button>
                </div>
                @if (!Filtrados.Any())
                {
                    <div class="empty-state">
                        <Icono Nombre="flag" />
                        <h2>No hay solicitudes</h2>
                        <p>Prueba con otros estados para ver los ejemplos.</p>
                    </div>
                }
                else
                {
                    <div class="request-list">
                        @foreach (var Solicitud in ElementosPagina)
                        {
                            <article class="request-card">
                                <div>
                                    <h3>Solicitud N.° @Solicitud.Id</h3>
                                    <p class="muted">@Solicitud.FechaCreacion.ToString("dd/MM/yyyy, HH:mm")</p>
                                    <p>
                                        <strong>Solicitante:</strong>
                                        @Solicitud.Usuario
                                    </p>
                                    <p>
                                        <strong>Motivo:</strong>
                                        @Solicitud.Motivo
                                    </p>
                                    <p class="muted">
                                        @(Solicitud.Tipo == "Devoluciones" ? "Pedido" : "Reseña") N.°
                                        @Solicitud.IdReferencia
                                    </p>
                                </div>
                                <div class="request-actions">
                                    <span class="status @ClaseEstado(Solicitud.Estado)">@Solicitud.Estado</span>
                                    <button class="btn btn-secondary" @onclick="() => Abrir(Solicitud)">
                                        Ver solicitud
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                    <Paginacion Pagina="Pagina" TotalPaginas="TotalPaginas" PaginaCambiada="CambiarPagina" />
                }
            </div>
        </div>
    }
</div>
@if (SolicitudSeleccionada is not null)
{
    <Modal
        Titulo="@($"{(SolicitudSeleccionada.Tipo == "Devoluciones"
            ? "Solicitud de devolución"
            : "Reporte de reseña")} N.° {SolicitudSeleccionada.Id}")"
        AlCerrar="Cerrar"
        Amplio="true">
        <div class="request-summary">
            <span class="status @ClaseEstado(SolicitudSeleccionada.Estado)">@SolicitudSeleccionada.Estado</span>
            <p class="muted">
                Fecha de solicitud: @SolicitudSeleccionada.FechaCreacion.ToString("dd/MM/yyyy, HH:mm")
            </p>
        </div>
        <div class="request-details">
            <div>
                <span class="muted">Solicitante</span>
                <h3>@SolicitudSeleccionada.Usuario</h3>
            </div>
            <div>
                <span class="muted">Motivo</span>
                <p>@SolicitudSeleccionada.Motivo</p>
            </div>
        </div>
        <div class="request-comment">
            <span class="muted">Comentario adicional</span>
            <p>
                @(string.IsNullOrWhiteSpace(SolicitudSeleccionada.Comentario) ? "Sin comentario adicional" :
                SolicitudSeleccionada.Comentario)
            </p>
        </div>
        @if (SolicitudSeleccionada.Tipo == "Devoluciones")
        {
            @if (PedidoRelacionado is { } Pedido)
            {
                <div class="reference-box">
                    <h3>Pedido N.° @Pedido.Id</h3>
                    <div class="order-summary">
                        <span>
                            <small>Fecha de pago</small>
                            @Pedido.FechaPago.ToString("dd/MM/yyyy, HH:mm")
                        </span>
                        <span>
                            <small>Cantidad de libros</small>
                            @Pedido.Lineas.Sum(l => l.Cantidad)
                        </span>
                        <span>
                            <small>Total pagado</small>
                            <strong>@EstadoDemostracion.Dinero(Pedido.Total)</strong>
                        </span>
                        <span>
                            <small>Estado</small>
                            @Pedido.Estado
                        </span>
                    </div>
                </div>
            }
            else
            {
                <div class="reference-box">
                    <h3>Pedido N.° @SolicitudSeleccionada.IdReferencia</h3>
                    <p class="muted">La referencia no está disponible en estos datos de ejemplo.</p>
                </div>
            }
        }
        else
        {
            @if (ResenaRelacionada is { } Resena)
            {
                <div class="reference-box">
                    <h3>Reseña N.° @Resena.Id</h3>
                    <div class="review-reference">
                        <span>
                            Autor:
                            <strong>@Resena.Usuario</strong>
                            <br />
                            Libro:
                            <strong>@Estado.BuscarLibro(Resena.IdLibro)?.Titulo</strong>
                        </span>
                        <span class="status @(Resena.Activo ? "status-green" : "")">
                            @(Resena.Activo ? "Activa" : "Inactiva")
                        </span>
                    </div>
                </div>
                <div class="comparison-content">
                    <div class="reference-box">
                        <h3>Contenido original</h3>
                        <span class="stars">@MostrarEstrellas(SolicitudSeleccionada.PuntuacionOriginal)</span>
                        <p>@SolicitudSeleccionada.ComentarioOriginal</p>
                    </div>
                    <div class="reference-box">
                        <h3>Contenido actual</h3>
                        <span class="stars">@MostrarEstrellas(Resena.Puntuacion)</span>
                        <p>@Resena.Comentario</p>
                    </div>
                </div>
            }
            else
            {
                <div class="reference-box">
                    <h3>Reseña N.° @SolicitudSeleccionada.IdReferencia</h3>
                    <p class="muted">La referencia no está disponible en estos datos de ejemplo.</p>
                </div>
            }
        }
        @if (SolicitudSeleccionada.Estado == "Pendiente")
        {
            <div class="resolution-actions">
                @if (SolicitudSeleccionada.Tipo == "Reportes")
                {
                    <button class="btn btn-secondary" @onclick="ResolverCerrada">Cerrar solicitud</button>
                }
                <div>
                    <button class="btn btn-danger" @onclick="ResolverRechazada">Rechazar</button>
                    <button class="btn btn-primary" @onclick="ResolverAceptada">
                        Aceptar @(SolicitudSeleccionada.Tipo == "Devoluciones" ? "devolución" : "reporte")
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="resolution-result">
                <Icono Nombre="check" />
                <div>
                    <strong>Solicitud @SolicitudSeleccionada.Estado.ToLower()</strong>
                    <p class="muted">
                        Fecha de resolución:
                        @SolicitudSeleccionada.FechaResolucion?.ToString("dd/MM/yyyy, HH:mm")
                    </p>
                </div>
            </div>
        }
    </Modal>
}
