@page "/todas-resenas"
@implements IDisposable
<PageTitle>Todas las reseñas · BookShop</PageTitle>
<div class="container py-4">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="/administracion">Administración</a></li>
            <li class="breadcrumb-item"><a href="/moderacion">Moderación</a></li>
            <li class="breadcrumb-item active" aria-current="page"><span>Todas las reseñas</span></li>
        </ol>
    </nav>
    @if (!Estado.EsAdministrador)
    {
        <div class="empty-state">
            <Icono Nombre="user" />
            <h1>Acceso administrativo</h1>
            <p>Inicia sesión con demo@@admin.bookshop para recorrer estas pantallas.</p>
            <button class="btn btn-primary" @onclick="Estado.MostrarAcceso">Iniciar sesión</button>
        </div>
    }
    else
    {
        <div class="results-heading d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h1>Todas las reseñas</h1>
                <span class="text-body-secondary">@Filtrados.Count() reseñas</span>
            </div>
            <select class="form-select" aria-label="Ordenar reseñas" @bind="Orden" @bind:after="ReiniciarPagina">
                <option value="recent">Más recientes</option>
                <option value="votes-asc">Votos: menor a mayor</option>
                <option value="votes-desc">Votos: mayor a menor</option>
                <option value="stars-asc">Puntuación: menor a mayor</option>
                <option value="stars-desc">Puntuación: mayor a menor</option>
            </select>
        </div>
        @if (!Filtrados.Any())
        {
            <div class="empty-state">
                <Icono Nombre="star" />
                <h2>No hay reseñas</h2>
                <p>Las reseñas publicadas aparecerán aquí.</p>
            </div>
        }
        else
        {
            <div class="admin-reviews card px-4">
                @foreach (var Resena in ElementosPagina)
                {
                    var Libro = Estado.BuscarLibro(Resena.IdLibro);
                    <article class="admin-review d-flex flex-column flex-sm-row align-items-start gap-4">
                        <div class="review-images d-flex align-items-start gap-2">
                            <img class="user-image" src="@Resena.FotoUsuario" alt="@Resena.Usuario" />
                            <a href="@($"/libros/{Resena.IdLibro}")">
                                <img class="book-image" src="@Libro?.Portada" alt="@Libro?.Titulo" />
                            </a>
                        </div>
                        <div class="review-content d-flex flex-column gap-2 flex-grow-1">
                            <strong>@Resena.Usuario</strong>
                            <a href="@($"/libros/{Resena.IdLibro}")">@Libro?.Titulo</a>
                            <time class="text-body-secondary">@Resena.Fecha.ToString("dd/MM/yyyy")</time>
                            <span class="stars">@MostrarEstrellas(Resena.Puntuacion)</span>
                            <p>@Resena.Comentario</p>
                            <span class="review-votes d-flex align-items-center gap-2 text-body-secondary">
                                <Icono Nombre="thumb" />
                                @Resena.Votos votos útiles
                            </span>
                        </div>
                        <button class="btn btn-danger" @onclick="() => Eliminar(Resena)">
                            <Icono Nombre="trash" />
                            Eliminar
                        </button>
                    </article>
                }
            </div>
            <Paginacion Pagina="Pagina" TotalPaginas="TotalPaginas" PaginaCambiada="CambiarPagina" />
        }
    }
</div>
