@page "/administracion"
@inherits Web.Componentes.Paginas.Cuenta.PaginaCuenta
<PageTitle>Administración · BookShop</PageTitle>
<div class="container py-4">
    <h1 class="page-heading">Administración</h1>
    @if (Sesion.Usuario == null)
    {
        <p>Inicia sesión con una cuenta de administrador.</p>
        <button class="btn btn-primary" @onclick="Sesion.MostrarAcceso">Iniciar sesión</button>
    }
    else if (!Sesion.EsAdministrador)
    {
        <p class="alert alert-warning">Solo los administradores pueden acceder a esta pantalla.</p>
        <a class="btn btn-secondary" href="/catalogo">Volver al catálogo</a>
    }
    else
    {
        <h2 class="h4 mb-3">Catálogo</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-5">
            <div class="col"><a class="btn btn-secondary btn-lg w-100 py-4" href="/administracion/libros">Libros</a></div>
            <div class="col"><a class="btn btn-secondary btn-lg w-100 py-4" href="/administracion/autores">Autores</a></div>
            <div class="col"><a class="btn btn-secondary btn-lg w-100 py-4" href="/administracion/categorias">Categorías</a></div>
            <div class="col"><a class="btn btn-secondary btn-lg w-100 py-4" href="/administracion/editoriales">Editoriales</a></div>
        </div>
        <h2 class="h4 mb-3">Gestión</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
            <div class="col"><a class="btn btn-secondary btn-lg w-100 py-4" href="/moderacion">Moderación</a></div>
            <div class="col"><a class="btn btn-secondary btn-lg w-100 py-4" href="/administracion/configuracion">Configuración</a></div>
            <div class="col"><button class="btn btn-primary btn-lg w-100 py-4" @onclick="() => reportesAbiertos = true">Reportes</button></div>
        </div>
        @if (reportesAbiertos)
        {
            <ModalReportes AlCerrar="() => reportesAbiertos = false" />
        }
    }
</div>

@code {
    private bool reportesAbiertos;
}
