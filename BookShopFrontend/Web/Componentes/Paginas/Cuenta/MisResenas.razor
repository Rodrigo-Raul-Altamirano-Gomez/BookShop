@page "/mis-resenas"
@inherits PaginaCuenta
<PageTitle>Mis reseñas · BookShop</PageTitle>
<div class="container py-4">
    <h1>Mis reseñas</h1>
    @if (Sesion.Usuario == null)
    {
        <p>Inicia sesión para consultar tus reseñas.</p>
        <button class="btn btn-primary" @onclick="Sesion.MostrarAcceso">Iniciar sesión</button>
    }
    else
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 my-4">
            <span>@resultado.TotalResultados reseñas</span>
            <label class="d-flex align-items-center gap-2">Ordenar por:
                <select class="form-select" @bind="consulta.Orden" @bind:after="Ordenar" disabled="@(CargandoDatos || procesando)">
                    <option value="MAS_RECIENTES">Más recientes</option>
                    <option value="VOTOS_UTILES_ASCENDENTE">Votos ascendentes</option>
                    <option value="VOTOS_UTILES_DESCENDENTE">Votos descendentes</option>
                    <option value="PUNTUACION_ASCENDENTE">Puntuación ascendente</option>
                    <option value="PUNTUACION_DESCENDENTE">Puntuación descendente</option>
                </select>
            </label>
        </div>
        <Cargando EnCurso="@CargandoDatos" Error="@ErrorCarga" AlReintentar="ActualizarDatos">
            @if (resultado.Items.Count == 0)
            {
                <p>No tienes reseñas publicadas.</p>
            }
            @foreach (var resena in resultado.Items)
            {
                <article class="card p-4 mb-3">
                    <div class="d-flex gap-3 align-items-start">
                        <a href="/libros/@resena.IdLibro">
                            <img src="@(resena.PortadaLibro ?? "/images/book-placeholder.svg")" alt="Portada de @resena.TituloLibro"
                                style="width: 70px; height: 100px; object-fit: cover;" />
                        </a>
                        <div class="flex-grow-1">
                            <h2 class="h4"><a href="/libros/@resena.IdLibro">@resena.TituloLibro</a></h2>
                            <p class="text-body-secondary">@resena.Fecha.ToString("dd/MM/yyyy") · @resena.CantidadVotosUtiles votos útiles</p>
                            <p class="stars" aria-label="@($"{resena.Puntuacion} de 5 estrellas")">@(new string('★', resena.Puntuacion))</p>
                            <p>@resena.Comentario</p>
                            <div class="d-flex gap-2">
                                <button class="btn btn-secondary" @onclick="() => resenaEnEdicion = resena" disabled="@procesando">Editar</button>
                                <button class="btn btn-outline-danger" @onclick="() => Eliminar(resena.Id)" disabled="@procesando">Eliminar</button>
                            </div>
                        </div>
                    </div>
                </article>
            }
            <Paginacion Pagina="consulta.Pagina" TotalPaginas="TotalPaginas" PaginaCambiada="CambiarPagina" />
        </Cargando>
    }
    @if (resenaEnEdicion != null)
    {
        <FormularioResena Titulo="Editar reseña" Valor="resenaEnEdicion" AlGuardar="Guardar" AlCerrar="CerrarEdicion" />
    }
</div>
