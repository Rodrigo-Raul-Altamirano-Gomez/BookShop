@page "/mi-perfil"
@inherits PaginaCuenta
<PageTitle>Mi perfil · BookShop</PageTitle>
<div class="container">
    <nav class="breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <span>Cuenta</span>
        <span>/</span>
        <span>Mi perfil</span>
    </nav>
    <h1 class="page-heading">Mi perfil</h1>
    @if (Estado.Usuario is null)
    {
        <div class="empty-state">
            <Icono Nombre="user" />
            <h2>Tu cuenta, en un solo lugar</h2>
            <p>Inicia sesión para consultar tu perfil.</p>
            <button class="btn btn-primary" @onclick="Estado.MostrarAcceso">Iniciar sesión</button>
        </div>
    }
    else
    {
        <div class="profile-layout">
            <section class="panel">
                <div class="section-heading">
                    <h2>
                        <Icono Nombre="user" />
                        Datos personales
                    </h2>
                    <button class="btn btn-secondary" @onclick="EditarPerfil">
                        <Icono Nombre="edit" />
                        Editar datos
                    </button>
                </div>
                <div class="profile-photo">
                    <img src="@Estado.Usuario.Imagen" alt="Foto de perfil de @Estado.Usuario.Nombre" />
                    <div class="photo-actions">
                        <label class="btn btn-secondary photo-picker" aria-label="Cambiar foto de perfil">
                            <Icono Nombre="edit" />
                            Cambiar foto
                            <InputFile
                                OnChange="CargarFoto"
                                accept="image/jpeg,image/png"
                                disabled="@CargandoImagen"
                                />
                        </label>
                        <button class="btn btn-secondary" @onclick="QuitarFoto" disabled="@CargandoImagen">
                            Quitar
                        </button>
                    </div>
                    @if (CargandoImagen)
                    {
                        <span class="muted" role="status">Cargando imagen…</span>
                    }
                    @if (ErrorImagen.Length > 0)
                    {
                        <p class="form-error" role="alert">@ErrorImagen</p>
                    }
                </div>
                <dl class="profile-data">
                    <div>
                        <dt>Nombre completo</dt>
                        <dd>@Estado.Usuario.Nombre</dd>
                    </div>
                    <div>
                        <dt>Correo electrónico</dt>
                        <dd>@Estado.Usuario.Correo</dd>
                    </div>
                    <div>
                        <dt>Fecha de nacimiento</dt>
                        <dd>@Estado.Usuario.Nacimiento.ToString("dd/MM/yyyy")</dd>
                    </div>
                </dl>
            </section>
            <section class="panel security-panel">
                <h2>
                    <Icono Nombre="shield" />
                    Seguridad y cuenta
                </h2>
                <div>
                    <h3>
                        <Icono Nombre="key" />
                        Contraseña
                    </h3>
                    <button class="btn btn-secondary" @onclick="AbrirContrasena">Cambiar contraseña</button>
                </div>
                <div>
                    <h3>
                        <Icono Nombre="power" />
                        Cuenta
                    </h3>
                    <button class="btn btn-danger" @onclick="AbrirDesactivacion">Desactivar cuenta</button>
                    <p class="muted">Conservarás tus datos y podrás reactivarla.</p>
                </div>
            </section>
        </div>
    }
</div>
@if (ModalAbierto == "profile")
{
    <Modal Titulo="Editar datos personales" AlCerrar="Cerrar">
        <form @onsubmit="GuardarPerfil" @onsubmit:preventDefault novalidate>
            <label class="field">
                Nombre completo *
                <input @bind="Nombre" @bind:event="oninput" maxlength="100" autocomplete="name" />
            </label>
            <label class="field">
                Fecha de nacimiento *
                <input type="date" @bind="Nacimiento" />
            </label>
            @if (MensajeError.Length > 0)
            {
                <p class="form-error" role="alert">@MensajeError</p>
            }
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                <button class="btn btn-primary" type="submit" disabled="@(string.IsNullOrWhiteSpace(Nombre))">
                    Guardar cambios
                </button>
            </div>
        </form>
    </Modal>
}
@if (ModalAbierto == "password")
{
    <Modal Titulo="Cambiar contraseña" AlCerrar="Cerrar">
        <form @onsubmit="GuardarContrasena" @onsubmit:preventDefault novalidate>
            <label class="field">
                Contraseña actual *
                <div class="password-field">
                    <input
                        type="@TipoContrasena"
                        @bind="ContrasenaActual"
                        @bind:event="oninput"
                        autocomplete="current-password"
                        />
                    <button
                        type="button"
                        class="icon-button"
                        @onclick="AlternarContrasenas"
                        aria-label="Mostrar u ocultar contraseña">
                        <Icono Nombre="eye" />
                    </button>
                </div>
            </label>
            <label class="field">
                Nueva contraseña *
                <input
                    type="@TipoContrasena"
                    @bind="NuevaContrasena"
                    @bind:event="oninput"
                    autocomplete="new-password"
                    />
            </label>
            <label class="field">
                Confirmar nueva contraseña *
                <input
                    type="@TipoContrasena"
                    @bind="ConfirmacionContrasena"
                    @bind:event="oninput"
                    autocomplete="new-password"
                    />
            </label>
            @if (MensajeError.Length > 0)
            {
                <p class="form-error" role="alert">@MensajeError</p>
            }
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                <button type="submit" class="btn btn-primary" disabled="@(!ContrasenasCompletas)">
                    Guardar cambios
                </button>
            </div>
        </form>
    </Modal>
}
@if (ModalAbierto == "deactivate")
{
    <Modal Titulo="Desactivar cuenta" AlCerrar="Cerrar">
        <p>Tu cuenta quedará desactivada. Conservarás tus datos, pedidos y listas para cuando decidas volver.</p>
        <form @onsubmit="Desactivar" @onsubmit:preventDefault novalidate>
            <label class="field">
                Contraseña *
                <div class="password-field">
                    <input
                        type="@TipoContrasena"
                        @bind="ContrasenaActual"
                        @bind:event="oninput"
                        autocomplete="current-password"
                        />
                    <button
                        type="button"
                        class="icon-button"
                        @onclick="AlternarContrasenas"
                        aria-label="Mostrar u ocultar contraseña">
                        <Icono Nombre="eye" />
                    </button>
                </div>
            </label>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                <button type="submit" class="btn btn-danger" disabled="@(ContrasenaActual.Length == 0)">
                    Desactivar cuenta
                </button>
            </div>
        </form>
    </Modal>
}
