@page "/mi-perfil"
@inherits PaginaCuenta
<PageTitle>Mi perfil · BookShop</PageTitle>
<div class="container py-4">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item">Cuenta</li>
            <li class="breadcrumb-item active"
                aria-current="page">Mi perfil</li>
        </ol>
    </nav>
    <h1 class="page-heading d-flex flex-wrap align-items-center justify-content-between gap-3">Mi perfil</h1>
    @if (Estado.Usuario is null)
    {
        <div class="empty-state card border-0 text-center align-items-center py-5">
            <Icono Nombre="user" />
            <h2 class="d-flex align-items-center gap-3">Tu cuenta, en un solo lugar</h2>
            <p>Inicia sesión para consultar tu perfil.</p>
            <button class="btn btn-primary" @onclick="Estado.MostrarAcceso">Iniciar sesión</button>
        </div>
    }
    else
    {
        <div class="profile-layout row g-4">
            <div class="col-12 col-lg-7">
                <section class="card p-4">
                    <div class="section-heading d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <h2 class="d-flex align-items-center gap-3">
                            <Icono Nombre="user" />
                            Datos personales
                        </h2>
                        <button class="btn btn-secondary" @onclick="EditarPerfil">
                            <Icono Nombre="edit" />
                            Editar datos
                        </button>
                    </div>
                    <div class="profile-photo d-flex align-items-center flex-wrap gap-3 py-3">
                        <img class="rounded-circle" src="@Estado.Usuario.Imagen"
                            alt="Foto de perfil de @Estado.Usuario.Nombre" />
                        <div class="photo-actions d-flex flex-wrap gap-2">
                            <label class="btn btn-secondary photo-picker position-relative overflow-hidden"
                                aria-label="Cambiar foto de perfil">
                                <Icono Nombre="edit" />
                                Cambiar foto
                                <InputFile
                                    OnChange="CargarFoto"
                                    accept="image/jpeg,image/png"
                                    disabled="@CargandoImagen"
                                    />
                            </label>
                            <button class="btn btn-secondary" @onclick="QuitarFoto" disabled="@CargandoImagen">
                                Quitar
                            </button>
                        </div>
                        @if (CargandoImagen)
                        {
                            <span class="text-body-secondary" role="status">Cargando imagen…</span>
                        }
                        @if (ErrorImagen.Length > 0)
                        {
                            <p class="alert alert-danger py-2" role="alert">@ErrorImagen</p>
                        }
                    </div>
                    <dl class="profile-data mb-0">
                        <div class="border-top py-3">
                            <dt class="mb-2">Nombre completo</dt>
                            <dd class="mb-0">@Estado.Usuario.Nombre</dd>
                        </div>
                        <div class="border-top py-3">
                            <dt class="mb-2">Correo electrónico</dt>
                            <dd class="mb-0">@Estado.Usuario.Correo</dd>
                        </div>
                        <div class="border-top py-3">
                            <dt class="mb-2">Fecha de nacimiento</dt>
                            <dd class="mb-0">@Estado.Usuario.Nacimiento.ToString("dd/MM/yyyy")</dd>
                        </div>
                    </dl>
                </section>
            </div>
            <div class="col-12 col-lg-5">
                <section class="card p-4 security-panel">
                    <h2 class="d-flex align-items-center gap-3">
                        <Icono Nombre="shield" />
                        Seguridad y cuenta
                    </h2>
                    <div class="border-top mt-4 pt-4">
                        <h3 class="d-flex align-items-center gap-2 mb-3">
                            <Icono Nombre="key" />
                            Contraseña
                        </h3>
                        <button class="btn btn-secondary" @onclick="AbrirContrasena">Cambiar contraseña</button>
                    </div>
                    <div class="border-top mt-4 pt-4">
                        <h3 class="d-flex align-items-center gap-2 mb-3">
                            <Icono Nombre="power" />
                            Cuenta
                        </h3>
                        <button class="btn btn-danger" @onclick="AbrirDesactivacion">Desactivar cuenta</button>
                        <p class="text-body-secondary">Conservarás tus datos y podrás reactivarla.</p>
                    </div>
                </section>
            </div>
        </div>
    }
</div>
@if (ModalAbierto == "profile")
{
    <Modal Titulo="Editar datos personales" AlCerrar="Cerrar">
        <form @onsubmit="GuardarPerfil" @onsubmit:preventDefault novalidate>
            <label class="field form-label d-block mb-3">
                Nombre completo *
                <input class="form-control" @bind="Nombre" @bind:event="oninput"
                    maxlength="100" autocomplete="name" />
            </label>
            <label class="field form-label d-block mb-3">
                Fecha de nacimiento *
                <input class="form-control" type="date" @bind="Nacimiento" />
            </label>
            @if (MensajeError.Length > 0)
            {
                <p class="alert alert-danger py-2" role="alert">@MensajeError</p>
            }
            <div class="modal-footer px-0 pb-0 d-flex flex-wrap gap-2 justify-content-end">
                <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                <button class="btn btn-primary" type="submit" disabled="@(string.IsNullOrWhiteSpace(Nombre))">
                    Guardar cambios
                </button>
            </div>
        </form>
    </Modal>
}
@if (ModalAbierto == "password")
{
    <Modal Titulo="Cambiar contraseña" AlCerrar="Cerrar">
        <form @onsubmit="GuardarContrasena" @onsubmit:preventDefault novalidate>
            <label class="field form-label d-block mb-3">
                Contraseña actual *
                <div class="input-group">
                    <input class="form-control"
                        type="@TipoContrasena"
                        @bind="ContrasenaActual"
                        @bind:event="oninput"
                        autocomplete="current-password"
                        />
                    <button
                        type="button"
                        class="btn btn-outline-secondary icon-button"
                        @onclick="AlternarContrasenas"
                        aria-label="Mostrar u ocultar contraseña">
                        <Icono Nombre="eye" />
                    </button>
                </div>
            </label>
            <label class="field form-label d-block mb-3">
                Nueva contraseña *
                <input class="form-control"
                    type="@TipoContrasena"
                    @bind="NuevaContrasena"
                    @bind:event="oninput"
                    autocomplete="new-password"
                    />
            </label>
            <label class="field form-label d-block mb-3">
                Confirmar nueva contraseña *
                <input class="form-control"
                    type="@TipoContrasena"
                    @bind="ConfirmacionContrasena"
                    @bind:event="oninput"
                    autocomplete="new-password"
                    />
            </label>
            @if (MensajeError.Length > 0)
            {
                <p class="alert alert-danger py-2" role="alert">@MensajeError</p>
            }
            <div class="modal-footer px-0 pb-0 d-flex flex-wrap gap-2 justify-content-end">
                <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                <button type="submit" class="btn btn-primary" disabled="@(!ContrasenasCompletas)">
                    Guardar cambios
                </button>
            </div>
        </form>
    </Modal>
}
@if (ModalAbierto == "deactivate")
{
    <Modal Titulo="Desactivar cuenta" AlCerrar="Cerrar">
        <p>Tu cuenta quedará desactivada. Conservarás tus datos, pedidos y listas para cuando decidas volver.</p>
        <form @onsubmit="Desactivar" @onsubmit:preventDefault novalidate>
            <label class="field form-label d-block mb-3">
                Contraseña *
                <div class="input-group">
                    <input class="form-control"
                        type="@TipoContrasena"
                        @bind="ContrasenaActual"
                        @bind:event="oninput"
                        autocomplete="current-password"
                        />
                    <button
                        type="button"
                        class="btn btn-outline-secondary icon-button"
                        @onclick="AlternarContrasenas"
                        aria-label="Mostrar u ocultar contraseña">
                        <Icono Nombre="eye" />
                    </button>
                </div>
            </label>
            <div class="modal-footer px-0 pb-0 d-flex flex-wrap gap-2 justify-content-end">
                <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                <button type="submit" class="btn btn-danger" disabled="@(ContrasenaActual.Length == 0)">
                    Desactivar cuenta
                </button>
            </div>
        </form>
    </Modal>
}
