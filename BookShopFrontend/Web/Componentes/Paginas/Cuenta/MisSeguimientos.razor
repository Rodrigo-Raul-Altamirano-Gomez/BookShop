@page "/mis-seguimientos"
@inherits PaginaCuenta
<PageTitle>Mis seguimientos · BookShop</PageTitle>
<div class="container py-4">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item">Cuenta</li>
            <li class="breadcrumb-item active"
                aria-current="page">Mis seguimientos</li>
        </ol>
    </nav>
    <div class="results-heading d-flex flex-wrap align-items-center justify-content-between gap-3">
        <h1>
            Mis seguimientos
            <span>@Referencias.Count @Tipo</span>
        </h1>
        @if (Estado.Usuario is not null)
        {
            <label class="sort-field form-label d-flex align-items-center gap-2">
                Ordenar por:
                <select class="form-select" @bind="Orden" @bind:after="ReiniciarPagina">
                    <option value="name">Nombre A–Z</option>
                    <option value="recent">Más recientes</option>
                </select>
            </label>
        }
    </div>
    @if (Estado.Usuario is null)
    {
        <div class="empty-state card border-0 text-center align-items-center py-5">
            <Icono Nombre="follow" />
            <h2>Sigue lo que te inspira</h2>
            <p>Inicia sesión para consultar tus seguimientos.</p>
            <button class="btn btn-primary" @onclick="Estado.MostrarAcceso">Iniciar sesión</button>
        </div>
    }
    else
    {
        <div class="nav nav-tabs bookshop-tabs" role="tablist" aria-label="Tipos de seguimiento">
            <button
                class="nav-link bookshop-tab @(Tipo == "autores" ? "active" : "")"
                role="tab"
                aria-selected="@(Tipo == "autores")"
                @onclick="MostrarAutores">
                Autores
            </button>
            <button
                class="nav-link bookshop-tab @(Tipo == "categorias" ? "active" : "")"
                role="tab"
                aria-selected="@(Tipo == "categorias")"
                @onclick="MostrarCategorias">
                Categorías
            </button>
            <button
                class="nav-link bookshop-tab @(Tipo == "editoriales" ? "active" : "")"
                role="tab"
                aria-selected="@(Tipo == "editoriales")"
                @onclick="MostrarEditoriales">
                Editoriales
            </button>
        </div>
        @if (Referencias.Count == 0)
        {
            <div class="empty-state card border-0 text-center align-items-center py-5">
                <h2>Aún no hay seguimientos en esta lista</h2>
                <p>Consulta sus páginas para comenzar a seguirlos.</p>
                <a class="btn btn-primary" href="/referencias/@Tipo">Explorar @Tipo</a>
            </div>
        }
        else
        {
            <div class="reference-grid row row-cols-2 row-cols-md-3 row-cols-xl-6 g-4">
                @foreach (var referencia in ReferenciasPagina)
                {
                    <TarjetaReferencia Referencia="referencia" />
                }
            </div>
            <Paginacion Pagina="Pagina" TotalPaginas="TotalPaginas" PaginaCambiada="CambiarPagina" />
        }
    }
</div>
