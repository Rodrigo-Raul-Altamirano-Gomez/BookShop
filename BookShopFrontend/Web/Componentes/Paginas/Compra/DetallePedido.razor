@inherits Web.Componentes.Paginas.Cuenta.PaginaCuenta
@page "/confirmacion/{Id:int}"
@page "/pedidos/{Id:int}"
<PageTitle>Detalle del pedido · BookShop</PageTitle>
<Cargando EnCurso="@CargandoDatos" Error="@ErrorCarga" AlReintentar="ActualizarDatos">
<div class="container py-4">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="/mis-pedidos">Mis pedidos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Pedido #@Id</li>
        </ol>
    </nav>
    @if (Sesion.Usuario == null)
    {
        <h1>Detalle del pedido</h1>
        <button class="btn btn-primary" @onclick="Sesion.MostrarAcceso">Iniciar sesión</button>
    }
    else if (pedido != null)
    {
        @if (Navegacion.Uri.Contains("/confirmacion/"))
        {
            <h1 class="text-center">Tu pedido ha sido registrado</h1>
            <p class="text-center">Gracias por elegir BookShop.</p>
        }
        else
        {
            <h1 class="visually-hidden">Detalle del pedido</h1>
        }
        <DetallePedidoContenido Pedido="pedido" />
        <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
            @if (pedido.Pedido.Estado is "EN_ALMACEN" or "EN_CAMINO")
            {
                <button class="btn btn-primary" @onclick="ActualizarSeguimiento" disabled="@procesando">Actualizar seguimiento</button>
            }
            @if (pedido.PuedeCancelar)
            {
                <button class="btn btn-outline-danger" @onclick="AbrirCancelacion" disabled="@procesando">Cancelar pedido</button>
            }
            @if (pedido.PuedeSolicitarDevolucion)
            {
                <button class="btn btn-secondary" @onclick="AbrirDevolucion" disabled="@procesando">Solicitar devolución</button>
            }
            <button class="btn btn-secondary" @onclick="DescargarComprobante" disabled="@generandoComprobante">
                @(generandoComprobante ? "Generando comprobante…" : "Descargar comprobante (PDF)")
            </button>
            <a class="btn btn-secondary" href="/mis-pedidos">Mis pedidos</a>
            <a class="btn btn-primary" href="/catalogo">Seguir explorando</a>
        </div>
        @if (errorComprobante != null)
        {
            <p class="alert alert-danger py-2 mt-3 text-center" role="alert">@errorComprobante</p>
        }
    }
    @if (formularioCancelacion)
    {
        <Modal Titulo="Cancelar pedido" AlCerrar="() => formularioCancelacion = false" Ocupado="@procesando">
            <form @onsubmit="CancelarPedido" @onsubmit:preventDefault>
                <label class="form-label d-block mb-3">Motivo
                    <textarea class="form-control" rows="4" @bind="cancelacion.Motivo" required></textarea>
                </label>
                @if (errorCancelacion != null)
                {
                    <p class="alert alert-danger" role="alert">@errorCancelacion</p>
                }
                <div class="modal-footer px-0 pb-0">
                    <button class="btn btn-secondary" type="button" @onclick="() => formularioCancelacion = false" disabled="@procesando">Volver</button>
                    <button class="btn btn-danger" type="submit" disabled="@procesando">Cancelar pedido</button>
                </div>
            </form>
        </Modal>
    }
    @if (formularioDevolucion)
    {
        <FormularioDevolucion AlGuardar="EnviarDevolucion" AlCerrar="() => formularioDevolucion = false" />
    }
</div>
</Cargando>
