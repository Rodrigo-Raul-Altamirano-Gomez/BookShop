@page "/confirmacion/{Id:int}"
<PageTitle>@(confirmacion ? "Pedido confirmado" : "Detalle del pedido") · BookShop</PageTitle>
<div class="container py-4">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="/catalogo">Catálogo</a></li>
            <li class="breadcrumb-item active"
                aria-current="page">Pedido #@Id</li>
        </ol>
    </nav>
    @if (Sesion.Usuario is null)
    {
        <div class="empty-state card border-0 text-center align-items-center py-5">
            <h1>Detalle del pedido</h1>
            <button class="btn btn-primary" @onclick="Sesion.MostrarAcceso">Iniciar sesión</button>
        </div>
    }
    else if (pedido is null)
    {
        <div class="empty-state card border-0 text-center align-items-center py-5">
            <h1>No encontramos este pedido</h1>
            <a class="btn btn-secondary" href="/catalogo">Volver al catálogo</a>
        </div>
    }
    else
    {
        <header class="order-detail-heading text-center">
            @if (confirmacion)
            {
                <span class="success-circle d-inline-flex align-items-center justify-content-center">
                    <Icono Nombre="check" />
                </span>
                <h1>Tu pedido ha sido registrado</h1>
                <p>Gracias por elegir BookShop.</p>
            }
            else
            {
                <h1>Pedido #@pedido.Id</h1>
            }
            <p class="text-body-secondary">Fecha de pago: @pedido.FechaPago.ToString("dd/MM/yyyy HH:mm")</p>
            <span class="badge bookshop-status @ClaseEstado(pedido.Estado)">@pedido.Estado</span>
        </header>
        <ResumenPedido Pedido="pedido" />
        <div class="text-center mt-4"><a class="btn btn-primary" href="/catalogo">Seguir explorando</a></div>
    }
</div>