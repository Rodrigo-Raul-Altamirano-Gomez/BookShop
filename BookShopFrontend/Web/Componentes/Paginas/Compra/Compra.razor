@page "/compra"
<PageTitle>Resumen de compra · BookShop</PageTitle>
<Cargando EnCurso="@cargando" Error="@errorCarga">
<div class="container py-4">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="/carrito">Carrito</a></li>
            <li class="breadcrumb-item active"
                aria-current="page">Resumen de compra</li>
        </ol>
    </nav>
    <div class="page-heading d-flex flex-wrap align-items-center justify-content-between gap-3">
        <h1>Resumen de compra</h1>
    </div>
    @if (Sesion.Usuario is null)
    {
        <div class="empty-state card border-0 text-center align-items-center py-5">
            <h2>Inicia sesión para continuar</h2>
            <button class="btn btn-primary" @onclick="Sesion.MostrarAcceso">Iniciar sesión</button>
        </div>
    }
    else if (Compras.CantidadCarrito == 0)
    {
        <div class="empty-state card border-0 text-center align-items-center py-5">
            <h2>Tu carrito está vacío</h2>
            <a class="btn btn-primary" href="/catalogo">Explorar catálogo</a>
        </div>
    }
    else
    {
        <div class="checkout-layout row g-4 align-items-start">
            <div class="col-12 col-xl-7">
                <div class="selection-groups d-flex flex-column gap-4">
                    <section class="card p-4 selection-panel">
                        <div class="section-heading d-flex flex-wrap align-items-center
                            justify-content-between gap-3">
                            <h2>
                                <Icono Nombre="pin" />
                                Dirección de envío
                            </h2>
                            <button class="btn btn-secondary" @onclick="() => formularioDireccion = true">
                                <Icono Nombre="plus" />
                                Añadir dirección
                            </button>
                        </div>
                        @if (Cuenta.Direcciones.Count == 0)
                        {
                            <p class="text-body-secondary">Añade una dirección de envío.</p>
                        }
                        else
                        {
                            <div class="selection-carousel d-flex align-items-center gap-2">
                                <button
                                    class="btn btn-outline-secondary icon-button"
                                    aria-label="Direcciones anteriores"
                                    disabled="@(indiceDireccion == 0)"
                                    @onclick="() => indiceDireccion--">
                                    ‹
                                </button>
                                <div class="selection-cards row row-cols-1 row-cols-xl-2 g-3 flex-grow-1">
                                    @foreach (var direccion in Cuenta.Direcciones.Skip(indiceDireccion).Take(2))
                                    {
                                        <div class="col">
                                            <button
                                                class="selection-card btn btn-outline-secondary w-100 h-100
                                                    d-flex gap-3 text-start
                                                    @(direccionId == direccion.Id ? "selected" : "")"
                                                @onclick="() => Seleccionar(direccion.Id, metodoId, cuponId)">
                                                <span class="radio-mark">
                                                </span>
                                                <div>
                                                    <h3>
                                                        @direccion.Alias @if (direccion.Predeterminada)
                                                        {
                                                            <span class="badge badge-bookshop">
                                                                Predeterminada
                                                            </span>
                                                        }
                                                    </h3>
                                                    <p>
                                                        @direccion.Calle
                                                        <br />
                                                        @direccion.Distrito, @direccion.Ciudad
                                                        <br />
                                                        @direccion.ReferenciaAdicional
                                                    </p>
                                                </div>
                                            </button>
                                        </div>
                                    }
                                </div>
                                <button
                                    class="btn btn-outline-secondary icon-button"
                                    aria-label="Más direcciones"
                                    disabled="@(indiceDireccion + 2 >= Cuenta.Direcciones.Count)"
                                    @onclick="() => indiceDireccion++">
                                    ›
                                </button>
                            </div>
                            <p class="carousel-position">
                                @(indiceDireccion + 1) –
                                @Math.Min(indiceDireccion + 2, Cuenta.Direcciones.Count) de
                                @Cuenta.Direcciones.Count
                            </p>
                        }
                    </section>
                    <section class="card p-4 selection-panel">
                        <div class="section-heading d-flex flex-wrap align-items-center
                            justify-content-between gap-3">
                            <h2>
                                <Icono Nombre="card" />
                                Método de pago
                            </h2>
                            <button class="btn btn-secondary" @onclick="() => formularioMetodo = true">
                                <Icono Nombre="plus" />
                                Añadir método
                            </button>
                        </div>
                        @if (Cuenta.Metodos.Count == 0)
                        {
                            <p class="text-body-secondary">Añade un método de pago.</p>
                        }
                        else
                        {
                            <div class="selection-carousel d-flex align-items-center gap-2">
                                <button
                                    class="btn btn-outline-secondary icon-button"
                                    aria-label="Métodos anteriores"
                                    disabled="@(indiceMetodo == 0)"
                                    @onclick="() => indiceMetodo--">
                                    ‹
                                </button>
                                <div class="selection-cards row row-cols-1 row-cols-xl-2 g-3 flex-grow-1">
                                    @foreach (var metodo in Cuenta.Metodos.Skip(indiceMetodo).Take(2))
                                    {
                                        <div class="col">
                                            <button
                                                class="selection-card btn btn-outline-secondary w-100 h-100
                                                    d-flex gap-3 text-start
                                                    @(metodoId == metodo.Id ? "selected" : "")"
                                                disabled="@(!metodo.Vigente || procesando)"
                                                @onclick="() => Seleccionar(direccionId, metodo.Id, cuponId)">
                                                <span class="radio-mark">
                                                </span>
                                                <div>
                                                    <h3>
                                                        @metodo.Alias @if (metodo.Predeterminada)
                                                        {
                                                            <span class="badge badge-bookshop">
                                                                Predeterminado
                                                            </span>
                                                        }
                                                    </h3>
                                                    <p>
                                                        <Icono
                                                            Nombre="@(metodo.Tipo == "Tarjeta"
                                                                ? "card" : "wallet")"
                                                            />
                                                        @metodo.Proveedor · @metodo.TipoTarjeta
                                                        <br />
                                                        @metodo.NumeroEnmascarado
                                                        <br />
                                                        @metodo.Titular
                                                        <br />
                                                        <span class="text-body-secondary small">
                                                            Vence @metodo.Vencimiento.ToString("MM/yyyy")
                                                        </span>
                                                    </p>
                                                </div>
                                            </button>
                                        </div>
                                    }
                                </div>
                                <button
                                    class="btn btn-outline-secondary icon-button"
                                    aria-label="Más métodos"
                                    disabled="@(indiceMetodo + 2 >= Cuenta.Metodos.Count)"
                                    @onclick="() => indiceMetodo++">
                                    ›
                                </button>
                            </div>
                            <p class="carousel-position">
                                @(indiceMetodo + 1) – @Math.Min(indiceMetodo + 2, Cuenta.Metodos.Count) de
                                @Cuenta.Metodos.Count
                            </p>
                        }
                    </section>
                    <section class="card p-4 selection-panel">
                        <div class="section-heading d-flex flex-wrap align-items-center
                            justify-content-between gap-3">
                            <h2>
                                <Icono Nombre="tag" />
                                Cupón
                            </h2>
                        </div>
                        <div class="selection-carousel d-flex align-items-center gap-2">
                            <button
                                class="btn btn-outline-secondary icon-button"
                                aria-label="Cupones anteriores"
                                disabled="@(indiceCupon == 0)"
                                @onclick="() => indiceCupon--">
                                ‹
                            </button>
                            <div class="selection-cards row row-cols-1 row-cols-xl-2 g-3 flex-grow-1">
                                @foreach (var cupon in CuponesVisibles)
                                {
                                    <div class="col">
                                        <button
                                            class="selection-card btn btn-outline-secondary w-100 h-100
                                                d-flex gap-3 text-start
                                                @(cuponId == cupon?.Id ? "selected" : "")"
                                            @onclick="() => Seleccionar(direccionId, metodoId, cupon?.Id)">
                                            <span class="radio-mark">
                                            </span>
                                            <div>
                                                @if (cupon is null)
                                                {
                                                    <h3>Sin cupón</h3>
                                                }
                                                else
                                                {
                                                    <h3>@cupon.Porcentaje% de descuento</h3>
                                                    <p>
                                                        Mínimo @Presentacion.Dinero(cupon.Minimo)
                                                        <br />
                                                        Vence @cupon.Vencimiento.ToString("dd/MM/yyyy")
                                                    </p>
                                                }
                                            </div>
                                        </button>
                                    </div>
                                }
                            </div>
                            <button
                                class="btn btn-outline-secondary icon-button"
                                aria-label="Más cupones"
                                disabled="@(indiceCupon + 2 >= Cupones.Count)"
                                @onclick="() => indiceCupon++">
                                ›
                            </button>
                        </div>
                        <p class="carousel-position">
                            @(indiceCupon + 1) – @Math.Min(indiceCupon + 2, Cupones.Count) de @Cupones.Count
                        </p>
                    </section>
                </div>
            </div>
            <div class="col-12 col-xl-5">
                <aside class="card p-4 checkout-summary">
                    <h2>Tu compra</h2>
                    <div class="table-responsive">
                        <table class="table align-middle line-table mb-3">
                            <thead>
                                <tr>
                                    <th>Libro</th>
                                    <th>Cant.</th>
                                    <th>Precio</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var linea in Compras.Resumen!.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="line-book d-flex align-items-center gap-3">
                                                <img src="@(linea.Portada ?? "/images/book-placeholder.svg")"
                                                    alt="@linea.Titulo" />
                                                <strong>@linea.Titulo</strong>
                                            </div>
                                        </td>
                                        <td>@linea.Cantidad</td>
                                        <td>
                                            <div class="line-price d-flex flex-column gap-1">
                                                @if (linea.PorcentajeDescuento > 0)
                                                {
                                                    <del>@Presentacion.Dinero(linea.PrecioOriginal)</del>
                                                }
                                                @Presentacion.Dinero(linea.PrecioUnitario)
                                            </div>
                                        </td>
                                        <td>@Presentacion.Dinero(linea.Subtotal)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="summary-lines d-flex flex-column gap-2">
                        <div class="d-flex justify-content-between gap-3">
                            <span>Productos</span>
                            <span>@Presentacion.Dinero(Productos)</span>
                        </div>
                        <div class="discount d-flex justify-content-between gap-3">
                            <span>Descuentos de libros</span>
                            <span>− @Presentacion.Dinero(Productos - Subtotal)</span>
                        </div>
                        <div class="d-flex justify-content-between gap-3">
                            <span>Subtotal</span>
                            <span>@Presentacion.Dinero(Subtotal)</span>
                        </div>
                        <hr />
                        <div class="discount d-flex justify-content-between gap-3">
                            <span>Cupón</span>
                            <span>− @Presentacion.Dinero(DescuentoCupon)</span>
                        </div>
                        <div class="d-flex justify-content-between gap-3">
                            <span>Envío</span>
                            <span>@Presentacion.Dinero(CostoEnvio)</span>
                        </div>
                        <div class="total d-flex justify-content-between gap-3">
                            <span>Total a pagar</span>
                            <span>@Presentacion.Dinero(Total)</span>
                        </div>
                    </div>
                    @if (errorPago is not null)
                    {
                        <p class="alert alert-danger py-2" role="alert">@errorPago</p>
                    }
                    <button
                        class="btn btn-primary"
                        disabled="@(Compras.Preparacion?.PuedePagar != true || procesando)"
                        @onclick="Confirmar">
                        @(procesando ? "Procesando…" : "Confirmar y pagar")
                    </button>
                    <a class="btn btn-secondary" href="/carrito">Volver al carrito</a>
                </aside>
            </div>
        </div>
    }
</div>
@if (formularioDireccion)
{
    <FormularioDireccion AlGuardar="GuardarDireccion" AlCerrar="() => formularioDireccion = false" />
}
@if (formularioMetodo)
{
    <FormularioPago AlGuardar="GuardarMetodo" AlCerrar="() => formularioMetodo = false" />
}
</Cargando>
