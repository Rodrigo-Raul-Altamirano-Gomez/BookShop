@page "/carrito"
<PageTitle>Carrito · BookShop</PageTitle>
<div class="container py-4">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active"
                aria-current="page">Carrito</li>
        </ol>
    </nav>
    <div class="page-heading d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="action-row d-flex flex-wrap align-items-center gap-2">
            <h1>Tu carrito</h1>
            <span class="text-body-secondary">@Estado.CantidadCarrito ejemplares</span>
        </div>
        @if (Estado.CantidadCarrito > 0)
        {
            <button class="btn btn-secondary" @onclick="Vaciar">Vaciar carrito</button>
        }
    </div>
    @if (Estado.CantidadCarrito == 0)
    {
        <div class="empty-state card border-0 text-center align-items-center py-5">
            <Icono Nombre="cart" />
            <h2>Tu próxima lectura te espera</h2>
            <p>Aún no has añadido libros al carrito.</p>
            <a class="btn btn-primary" href="/catalogo">Explorar catálogo</a>
        </div>
    }
    else
    {
        <div class="row g-4 align-items-start">
            <div class="col-12 col-lg-8">
                <section class="card p-4 cart-lines">
                    <div class="table-responsive">
                        <table class="table align-middle line-table mb-3">
                            <thead>
                                <tr>
                                    <th>Libro</th>
                                    <th>Precio unitario</th>
                                    <th>Cantidad</th>
                                    <th>Subtotal</th>
                                    <th>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in Estado.Carrito.ToList())
                                {
                                    var book = Estado.BuscarLibro(line.Key);
                                    if (book is not null)
                                    {
                                        <tr>
                                            <td>
                                                <div class="line-book d-flex align-items-center gap-3">
                                                    <a href="/libros/@book.Id">
                                                        <img src="@book.Portada" alt="Portada de @book.Titulo" />
                                                    </a>
                                                    <strong>@book.Titulo</strong>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="line-price d-flex flex-column gap-1">
                                                    @if (book.Descuento > 0)
                                                    {
                                                        <del>@EstadoDemostracion.Dinero(book.PrecioOriginal)</del>
                                                        <span class="badge badge-bookshop">−@book.Descuento%</span>
                                                    }
                                                    <strong>@EstadoDemostracion.Dinero(book.Precio)</strong>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="quantity btn-group">
                                                    <button class="btn btn-outline-secondary"
                                                        aria-label="Reducir cantidad de @book.Titulo"
                                                        @onclick="() => Cambiar(book.Id, line.Value - 1)">
                                                        −
                                                    </button>
                                                    <span>@line.Value</span>
                                                    <button class="btn btn-outline-secondary"
                                                        aria-label="Aumentar cantidad de @book.Titulo"
                                                        @onclick="() => Cambiar(book.Id, line.Value + 1)">
                                                        +
                                                    </button>
                                                </div>
                                            </td>
                                            <td>@EstadoDemostracion.Dinero(book.Precio * line.Value)</td>
                                            <td>
                                                <button
                                                    class="btn btn-outline-secondary icon-button"
                                                    aria-label="Retirar @book.Titulo"
                                                    @onclick="() => Cambiar(book.Id, 0)">
                                                    <Icono Nombre="trash" />
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <a class="text-link" href="/catalogo">← Seguir explorando</a>
                </section>
            </div>
            <div class="col-12 col-lg-4">
                <aside class="card p-4 cart-summary">
                    <h2>Resumen</h2>
                    <div class="summary-lines d-flex flex-column gap-2">
                        <div class="d-flex justify-content-between gap-3">
                            <span>Productos</span>
                            <span>@EstadoDemostracion.Dinero(Productos)</span>
                        </div>
                        <div class="discount d-flex justify-content-between gap-3">
                            <span>Descuentos de libros</span>
                            <span>− @EstadoDemostracion.Dinero(Productos - Subtotal)</span>
                        </div>
                        <div class="d-flex justify-content-between gap-3">
                            <span>Subtotal</span>
                            <span>@EstadoDemostracion.Dinero(Subtotal)</span>
                        </div>
                        <div class="d-flex justify-content-between gap-3">
                            <span>Envío</span>
                            <span>@EstadoDemostracion.Dinero(EnvioEjemplo)</span>
                        </div>
                        <div class="total d-flex justify-content-between gap-3">
                            <span>Total</span>
                            <span>@EstadoDemostracion.Dinero(Subtotal + EnvioEjemplo)</span>
                        </div>
                    </div>
                    <button class="btn btn-primary" @onclick="Continuar">
                        Continuar compra
                        <Icono Nombre="arrow" />
                    </button>
                </aside>
            </div>
        </div>
        <section class="section">
            <div class="section-heading d-flex flex-wrap align-items-center justify-content-between gap-3">
                <h2>Completa tu biblioteca</h2>
            </div>
            <div class="book-grid row row-cols-2 row-cols-md-4 g-4">
                @foreach (var book in Complementarios)
                {
                    <TarjetaLibro Libro="book" />
                }
            </div>
        </section>
    }
</div>
