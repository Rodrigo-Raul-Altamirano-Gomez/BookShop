@page "/mis-pedidos"
<PageTitle>Mis pedidos · BookShop</PageTitle>
<div class="container">
    <nav class="breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        Mis pedidos
    </nav>
    @if (Estado.Usuario is null)
    {
        <h1>Mis pedidos</h1>
        <div class="empty-state">
            <h2>Todos tus pedidos, en un lugar</h2>
            <button class="btn btn-primary" @onclick="Estado.MostrarAcceso">Iniciar sesión</button>
        </div>
    }
    else
    {
        <div class="catalog-layout">
            <aside class="filters">
                <h2>Filtros</h2>
                <div class="filter-group">
                    <h3>Estado del pedido</h3>
                    @foreach (var status in Estados)
                    {
                        <label>
                            <input
                                type="checkbox"
                                checked="@preparados.Contains(status)"
                                @onchange="() => SeleccionarEstado(status)"
                                />
                            @status
                        </label>
                    }
                </div>
                <h3>Filtros activos</h3>
                <div class="chips">
                    @foreach (var status in aplicados)
                    {
                        <button class="chip" @onclick="() => QuitarEstado(status)">@status ×</button>
                    }
                </div>
                <button class="btn btn-primary" @onclick="Aplicar">Aplicar filtros</button>
                <button class="btn btn-secondary" @onclick="Limpiar">Limpiar filtros</button>
            </aside>
            <section>
                <div class="results-heading">
                    <div class="action-row">
                        <h1>Mis pedidos</h1>
                        <span class="muted">@Filtrados.Count pedidos</span>
                    </div>
                    <label class="sort-field">
                        Ordenar por:
                        <select @bind="orden" @bind:after="ReiniciarPagina">
                            <option value="fecha">Más recientes</option>
                            <option value="menor">Total: menor a mayor</option>
                            <option value="mayor">Total: mayor a menor</option>
                        </select>
                    </label>
                </div>
                @if (Filtrados.Count == 0)
                {
                    <div class="empty-state">
                        <h2>No hay pedidos con estos filtros</h2>
                        <button class="btn btn-secondary" @onclick="Limpiar">Limpiar filtros</button>
                    </div>
                }
                @foreach (var order in Filtrados.Skip((pagina - 1) * 10).Take(10))
                {
                    <article class="panel order-card">
                        <div class="order-covers">
                            @foreach (var line in order.Lineas.Take(3))
                            {
                                var book = Estado.BuscarLibro(line.IdLibro);
                                <img
                                    src="@(book?.Portada ?? "/images/book-placeholder.svg")"
                                    alt="Portada de @(book?.Titulo ?? "libro")"
                                    />
                            }
                            @if (order.Lineas.Count > 3)
                            {
                                <span>+@(order.Lineas.Count - 3)</span>
                            }
                        </div>
                        <div class="order-card-info">
                            <h3>Pedido #@order.Id</h3>
                            <p class="muted">Fecha de pago: @order.FechaPago.ToString("dd/MM/yyyy HH:mm")</p>
                            <p>Cantidad de libros: @order.Lineas.Sum(l => l.Cantidad)</p>
                            <strong>@EstadoDemostracion.Dinero(order.Total)</strong>
                        </div>
                        <div class="order-card-actions">
                            <span class="status @ClaseEstado(order.Estado)">@order.Estado</span>
                            <a class="btn btn-secondary" href="/pedidos/@order.Id">Ver detalle</a>
                        </div>
                    </article>
                }
                <Paginacion
                    Pagina="pagina"
                    TotalPaginas="@((Filtrados.Count + 9) / 10)"
                    PaginaCambiada="CambiarPagina"
                    />
            </section>
        </div>
    }
</div>
