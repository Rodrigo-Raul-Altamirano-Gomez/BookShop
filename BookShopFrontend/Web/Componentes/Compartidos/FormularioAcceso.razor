<Modal Titulo="@(reactivacion ? "Reactivar cuenta" : "Bienvenido a BookShop")" AlCerrar="Cerrar">
    @if (!reactivacion)
    {
        <div class="nav nav-tabs bookshop-tabs mb-4" role="tablist">
            <button class="nav-link bookshop-tab @(!registro ? "active" : "")"
                role="tab"
                aria-selected="@(!registro)" @onclick="PestanaAcceso">Iniciar sesión</button>
            <button class="nav-link bookshop-tab @(registro ? "active" : "")"
                role="tab"
                aria-selected="@registro" @onclick="PestanaRegistro">Crear cuenta</button>
        </div>
    }
    <form @onsubmit="Enviar" @onsubmit:preventDefault>
        @if (reactivacion)
        {
            <p>Tu cuenta está desactivada. Puedes reactivarla y conservar tus datos.</p>
        }
        @if (registro)
        {
            <div class="profile-photo-picker d-flex align-items-center gap-3 mb-3">
                <img src="@foto" alt="Vista previa de la foto de perfil" />
                <label class="btn btn-outline-secondary icon-button photo-input" title="Elegir foto">
                    <Icono Nombre="edit" />
                    <InputFile
                        OnChange="ElegirFoto"
                        accept="image/jpeg,image/png"
                        aria-label="Elegir foto de perfil"
                        />
                </label>
                <button
                    type="button"
                    class="btn btn-outline-secondary icon-button"
                    @onclick="QuitarFoto"
                    aria-label="Quitar foto"
                >
                    <Icono Nombre="trash" />
                </button>
            </div>
            <label class="field form-label d-block mb-3">
                Nombre completo *
                <input class="form-control" @bind="nombre" @bind:event="oninput" required autocomplete="name" />
            </label>
        }
        @if (!reactivacion)
        {
            <label class="field form-label d-block mb-3">
                Correo electrónico *
                <input
                    class="form-control"
                    type="email"
                    @bind="correo"
                    @bind:event="oninput"
                    required
                    autocomplete="email"
                />
            </label>
        }
        @if (registro)
        {
            <label class="field form-label d-block mb-3">
                Fecha de nacimiento *
                <input class="form-control" type="date" @bind="nacimiento" required />
            </label>
        }
        @if (!reactivacion)
        {
            <label class="field form-label d-block mb-3">
                Contraseña *
                <div class="input-group">
                    <input class="form-control"
                        type="@(mostrarContrasena ? "text" : "password")"
                        @bind="contrasena"
                        @bind:event="oninput"
                        required
                        autocomplete="@(registro ? "new-password" : "current-password")"
                        />
                    <button
                        class="btn btn-outline-secondary"
                        type="button"
                        @onclick="AlternarContrasena"
                        aria-label="@(mostrarContrasena ? "Ocultar contraseña" : "Mostrar contraseña")">
                        @(mostrarContrasena ? "Ocultar" : "Mostrar")
                    </button>
                </div>
            </label>
            @if (registro)
            {
                <label class="field form-label d-block mb-3">
                    Confirmar contraseña *
                    <input class="form-control"
                        type="@(mostrarContrasena ? "text" : "password")"
                        @bind="confirmacion"
                        @bind:event="oninput"
                        required
                        autocomplete="new-password"
                        />
                </label>
            }
        }
        @if (error is not null)
        {
            <p class="alert alert-danger form-error" role="alert">@error</p>
        }
        <div class="modal-footer px-0 pb-0 mt-4">
            <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
            <button type="submit" class="btn btn-primary">
                @(reactivacion ? "Reactivar cuenta" : registro ? "Crear cuenta" : "Iniciar sesión")
            </button>
        </div>
    </form>
</Modal>
