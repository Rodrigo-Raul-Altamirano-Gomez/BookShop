<div aria-busy="@EnCurso">
    @if (EnCurso)
    {
        <div class="estado-carga d-flex flex-column align-items-center justify-content-center gap-3 p-4 my-3"
            role="status" aria-live="polite">
            <span class="spinner-border" aria-hidden="true"></span>
            <span>@Mensaje</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger my-3" role="alert">
            <p class="mb-0">@Error</p>
            @if (AlReintentar.HasDelegate)
            {
                <button class="btn btn-secondary mt-3" @onclick="AlReintentar">Reintentar</button>
            }
        </div>
    }
    else
    {
        @ChildContent
    }
</div>
