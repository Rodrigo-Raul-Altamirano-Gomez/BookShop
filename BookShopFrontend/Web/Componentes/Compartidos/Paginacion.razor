@if (TotalPaginas > 1)
{
    <nav class="mt-4" aria-label="Páginas de resultados">
        <ul class="pagination justify-content-center gap-2 mb-0">
            <li class="page-item @(Pagina <= 1 ? "disabled" : "")">
                <button
                    class="page-link"
                    disabled="@(Pagina <= 1)"
                    @onclick="() => PaginaCambiada.InvokeAsync(Pagina - 1)"
                    aria-label="Página anterior">
                    ‹
                </button>
            </li>
            @foreach (var p in PaginasVisibles)
            {
                <li class="page-item @(Pagina == p ? "active" : "")">
                    <button
                        class="page-link"
                        aria-current="@(Pagina == p ? "page" : null)"
                        aria-label="Página @p"
                        @onclick="() => PaginaCambiada.InvokeAsync(p)">
                        @p
                    </button>
                </li>
            }
            <li class="page-item @(Pagina >= TotalPaginas ? "disabled" : "")">
                <button
                    class="page-link"
                    disabled="@(Pagina >= TotalPaginas)"
                    @onclick="() => PaginaCambiada.InvokeAsync(Pagina + 1)"
                    aria-label="Página siguiente">
                    ›
                </button>
            </li>
        </ul>
    </nav>
}

@code {
    [Parameter]
    public int Pagina { get; set; } = 1;

    [Parameter]
    public int TotalPaginas { get; set; }

    [Parameter]
    public EventCallback<int> PaginaCambiada { get; set; }
    private IEnumerable<int> PaginasVisibles
    {
        get
        {
            int primeraPagina = Math.Max(1, Pagina - 2);
            int ultimaPagina = Math.Min(TotalPaginas, Pagina + 2);
            var paginas = new List<int>();
            for (int numero = primeraPagina; numero <= ultimaPagina; numero++)
                paginas.Add(numero);
            return paginas;
        }
    }
}
