<Modal Titulo="@(Valor is null ? "Añadir método de pago" : "Editar método de pago")" AlCerrar="AlCerrar" Ocupado="@Guardando">
    <div class="nav nav-tabs bookshop-tabs mb-4" role="tablist" aria-label="Tipo de método">
        <button
            type="button"
            role="tab"
            aria-selected="@(Borrador.TarjetaBancaria)"
            class="nav-link bookshop-tab @(Borrador.TarjetaBancaria ? "active" : "")"
            @onclick="() => CambiarTipo(true)"
            disabled="@(Guardando || Valor is not null && !Valor.TarjetaBancaria)">
            <Icono Nombre="card" />
            Tarjeta
        </button>
        <button
            type="button"
            role="tab"
            aria-selected="@(!Borrador.TarjetaBancaria)"
            class="nav-link bookshop-tab @(!Borrador.TarjetaBancaria ? "active" : "")"
            @onclick="() => CambiarTipo(false)"
            disabled="@(Guardando || Valor is not null && Valor.TarjetaBancaria)">
            <Icono Nombre="wallet" />
            Billetera
        </button>
    </div>
    <form @onsubmit="Guardar" @onsubmit:preventDefault>
        <label class="field form-label d-block mb-3">
            Titular *
            <input
                class="form-control"
                required @bind="Borrador.Titular"
                @bind:event="oninput"
                maxlength="150"
                autocomplete="cc-name"
            />
        </label>
        <div class="row g-3">
            <label class="field form-label d-block mb-3 col-md-6">
                Proveedor *
                <input class="form-control" required @bind="Borrador.Proveedor" @bind:event="oninput" maxlength="100" />
            </label>
            <label class="field form-label d-block mb-3 col-md-6">
                Alias
                <input class="form-control" @bind="Borrador.Alias" @bind:event="oninput" maxlength="100" />
            </label>
        </div>
        @if (Borrador.TarjetaBancaria)
        {
            <label class="field form-label d-block mb-3">
                Tipo de tarjeta *
                <select class="form-select" @bind="Borrador.TipoTarjeta">
                    <option value="CREDITO">Crédito</option>
                    <option value="DEBITO">Débito</option>
                </select>
            </label>
        }
        <label class="field form-label d-block mb-3">
            @(Borrador.TarjetaBancaria ? "Número de tarjeta" : "Número de celular") @(Valor is null ? "*" : "")
            <input class="form-control"
                required="@(Valor is null)" @bind="Borrador.Numero"
                @bind:event="oninput"
                inputmode="numeric"
                autocomplete="off"
                placeholder="@(Valor is null ? "Ingresa el número completo" :
                    "Deja vacío para conservar el número registrado")"
                />
        </label>
        @if (Valor is not null)
        {
            <p class="text-body-secondary">Número registrado: @Valor.NumeroEnmascarado</p>
        }
        @if (Borrador.TarjetaBancaria)
        {
            <label class="field form-label d-block mb-3">
                Fecha de vencimiento *
                <input class="form-control" type="date" required @bind="Borrador.FechaVencimiento" />
            </label>
        }
        <label class="form-check form-check-label my-3">
            <input class="form-check-input" type="checkbox" @bind="Borrador.Predeterminado" />
            Usar como predeterminado
        </label>
        @if (MensajeError.Length > 0)
        {
            <p class="alert alert-danger form-error" role="alert">@MensajeError</p>
        }
        <div class="modal-footer px-0 pb-0 mt-4">
            <button type="button" class="btn btn-secondary" @onclick="AlCerrar" disabled="@Guardando">Cancelar</button>
            <button type="submit" class="btn btn-primary" disabled="@Guardando">
                @(Valor is null ? "Guardar método" : "Guardar cambios")
            </button>
        </div>
    </form>
</Modal>
