@using Web.Modelos
<Modal Titulo="@(Valor is null ? "Añadir método de pago" : "Editar método de pago")" AlCerrar="AlCerrar">
    <div class="tabs" role="tablist" aria-label="Tipo de método">
        <button
            type="button"
            role="tab"
            aria-selected="@(Borrador.Tipo == "Tarjeta")"
            class="tab @(Borrador.Tipo == "Tarjeta" ? "active" : "")"
            @onclick="MostrarTarjeta"
            disabled="@(Valor is not null && Valor.Tipo != "Tarjeta")">
            <Icono Nombre="card" />
            Tarjeta
        </button>
        <button
            type="button"
            role="tab"
            aria-selected="@(Borrador.Tipo == "Billetera")"
            class="tab @(Borrador.Tipo == "Billetera" ? "active" : "")"
            @onclick="MostrarBilletera"
            disabled="@(Valor is not null && Valor.Tipo != "Billetera")">
            <Icono Nombre="wallet" />
            Billetera
        </button>
    </div>
    <form @onsubmit="Guardar" @onsubmit:preventDefault novalidate>
        <label class="field">
            Titular *
            <input @bind="Borrador.Titular" @bind:event="oninput" maxlength="100" autocomplete="cc-name" />
        </label>
        <div class="form-grid">
            <label class="field">
                Proveedor *
                <input @bind="Borrador.Proveedor" @bind:event="oninput" maxlength="60" />
            </label>
            <label class="field">
                Alias
                <input @bind="Borrador.Alias" @bind:event="oninput" maxlength="60" />
            </label>
        </div>
        @if (Borrador.Tipo == "Tarjeta")
        {
            <label class="field">
                Tipo de tarjeta *
                <select @bind="Borrador.TipoTarjeta">
                    <option>Crédito</option>
                    <option>Débito</option>
                </select>
            </label>
        }
        <label class="field">
            @(Borrador.Tipo == "Tarjeta" ? "Número de tarjeta" : "Número de celular") @(Valor is null ? "*" : "")
            <input
                @bind="Numero"
                @bind:event="oninput"
                inputmode="numeric"
                maxlength="24"
                autocomplete="off"
                placeholder="@(Valor is null ? "Ingresa el número completo" :
                    "Deja vacío para conservar el número registrado")"
                />
        </label>
        @if (Valor is not null)
        {
            <p class="muted">Número registrado: @Valor.NumeroEnmascarado</p>
        }
        @if (Borrador.Tipo == "Tarjeta")
        {
            <label class="field">
                Fecha de vencimiento *
                <input type="date" @bind="FechaVencimiento" />
            </label>
        }
        <label class="check-field">
            <input type="checkbox" @bind="Borrador.Predeterminada" />
            Usar como predeterminado
        </label>
        @if (MensajeError.Length > 0)
        {
            <p class="form-error" role="alert">@MensajeError</p>
        }
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" @onclick="AlCerrar">Cancelar</button>
            <button type="submit" class="btn btn-primary" disabled="@(!Completo || Guardando)">
                @(Valor is null ? "Guardar método" : "Guardar cambios")
            </button>
        </div>
    </form>
</Modal>
