@using Web.Modelos
<Modal Titulo="@(Valor is null ? "Añadir método de pago" : "Editar método de pago")" AlCerrar="AlCerrar">
    <div class="nav nav-tabs bookshop-tabs mb-4" role="tablist" aria-label="Tipo de método">
        <button
            type="button"
            role="tab"
            aria-selected="@(Borrador.Tipo == "Tarjeta")"
            class="nav-link bookshop-tab @(Borrador.Tipo == "Tarjeta" ? "active" : "")"
            @onclick="MostrarTarjeta"
            disabled="@(Valor is not null && Valor.Tipo != "Tarjeta")">
            <Icono Nombre="card" />
            Tarjeta
        </button>
        <button
            type="button"
            role="tab"
            aria-selected="@(Borrador.Tipo == "Billetera")"
            class="nav-link bookshop-tab @(Borrador.Tipo == "Billetera" ? "active" : "")"
            @onclick="MostrarBilletera"
            disabled="@(Valor is not null && Valor.Tipo != "Billetera")">
            <Icono Nombre="wallet" />
            Billetera
        </button>
    </div>
    <form @onsubmit="Guardar" @onsubmit:preventDefault novalidate>
        <label class="field form-label d-block mb-3">
            Titular *
            <input
                class="form-control"
                @bind="Borrador.Titular"
                @bind:event="oninput"
                maxlength="100"
                autocomplete="cc-name"
            />
        </label>
        <div class="row g-3">
            <label class="field form-label d-block mb-3 col-md-6">
                Proveedor *
                <input class="form-control" @bind="Borrador.Proveedor" @bind:event="oninput" maxlength="60" />
            </label>
            <label class="field form-label d-block mb-3 col-md-6">
                Alias
                <input class="form-control" @bind="Borrador.Alias" @bind:event="oninput" maxlength="60" />
            </label>
        </div>
        @if (Borrador.Tipo == "Tarjeta")
        {
            <label class="field form-label d-block mb-3">
                Tipo de tarjeta *
                <select class="form-select" @bind="Borrador.TipoTarjeta">
                    <option>Crédito</option>
                    <option>Débito</option>
                </select>
            </label>
        }
        <label class="field form-label d-block mb-3">
            @(Borrador.Tipo == "Tarjeta" ? "Número de tarjeta" : "Número de celular") @(Valor is null ? "*" : "")
            <input class="form-control"
                @bind="Numero"
                @bind:event="oninput"
                inputmode="numeric"
                maxlength="24"
                autocomplete="off"
                placeholder="@(Valor is null ? "Ingresa el número completo" :
                    "Deja vacío para conservar el número registrado")"
                />
        </label>
        @if (Valor is not null)
        {
            <p class="text-body-secondary">Número registrado: @Valor.NumeroEnmascarado</p>
        }
        @if (Borrador.Tipo == "Tarjeta")
        {
            <label class="field form-label d-block mb-3">
                Fecha de vencimiento *
                <input class="form-control" type="date" @bind="FechaVencimiento" />
            </label>
        }
        <label class="form-check form-check-label my-3">
            <input class="form-check-input" type="checkbox" @bind="Borrador.Predeterminada" />
            Usar como predeterminado
        </label>
        @if (MensajeError.Length > 0)
        {
            <p class="alert alert-danger form-error" role="alert">@MensajeError</p>
        }
        <div class="modal-footer px-0 pb-0 mt-4">
            <button type="button" class="btn btn-secondary" @onclick="AlCerrar">Cancelar</button>
            <button type="submit" class="btn btn-primary" disabled="@(!Completo || Guardando)">
                @(Valor is null ? "Guardar método" : "Guardar cambios")
            </button>
        </div>
    </form>
</Modal>
