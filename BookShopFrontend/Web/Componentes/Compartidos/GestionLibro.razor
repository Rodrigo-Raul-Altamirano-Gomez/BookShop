@if (Estado.EsAdministrador)
{
    <div class="management-actions d-flex flex-wrap gap-2 my-3">
        <button class="btn btn-secondary" @onclick="Abrir">
            <Icono Nombre="settings" />
            Gestionar
        </button>
        <button class="btn btn-secondary" @onclick="AlternarActivo">
            @(Libro.Activo ? "Desactivar" : "Activar")
        </button>
    </div>
}
@if (Mostrar)
{
    <Modal Titulo="@($"Gestionar libro · {Libro.Titulo}")" AlCerrar="Cerrar" Amplio="true">
        <div class="nav nav-tabs bookshop-tabs mb-4" role="tablist">
            @foreach (var Nombre in NombresPestanas)
            {
                <button
                    class="nav-link bookshop-tab @(Pestana == Nombre ? "active" : "")"
                    role="tab"
                    aria-selected="@(Pestana == Nombre)"
                    @onclick="() => ElegirPestana(Nombre)">
                    @Nombre
                </button>
            }
        </div>
        <form @onsubmit="Guardar" @onsubmit:preventDefault>
            @if (Pestana == "Datos del libro")
            {
                <div class="row g-3">
                    <label class="field form-label d-block mb-3 col-12">
                        Título *
                        <input class="form-control" @bind="Borrador.Titulo" @bind:event="oninput" required />
                    </label>
                    <label class="field form-label d-block mb-3 col-md-6">
                        Idioma *
                        <input class="form-control" @bind="Borrador.Idioma" @bind:event="oninput" required />
                    </label>
                    <label class="field form-label d-block mb-3 col-md-6">
                        Proveedor *
                        <input class="form-control" @bind="Borrador.Proveedor" @bind:event="oninput" required />
                    </label>
                    <label class="field form-label d-block mb-3 col-12">
                        Sinopsis *
                        <textarea
                            class="form-control"
                            rows="5"
                            @bind="Borrador.Sinopsis"
                            @bind:event="oninput"
                            required
                        >
                        </textarea>
                    </label>
                    <div class="col-12">
                        <div class="reference-readonly d-flex flex-wrap justify-content-between gap-3 p-3 rounded">
                            <span class="d-grid gap-1">
                                <small>Autor</small>
                                <strong>@Libro.Autor</strong>
                            </span>
                            <span class="d-grid gap-1">
                                <small>Categoría</small>
                                <strong>@Libro.Categoria</strong>
                            </span>
                            <span class="d-grid gap-1">
                                <small>Editorial</small>
                                <strong>@Libro.Editorial</strong>
                            </span>
                        </div>
                    </div>
                    <label class="field form-label d-block mb-3 col-md-6">
                        ISBN *
                        <input class="form-control" @bind="Borrador.ISBN" @bind:event="oninput" required />
                    </label>
                    <label class="field form-label d-block mb-3 col-md-6">
                        Año de edición *
                        <input
                            class="form-control"
                            type="number"
                            @bind="Borrador.Anio"
                            @bind:event="oninput"
                            min="1"
                            required
                        />
                    </label>
                    <label class="field form-label d-block mb-3 col-md-6">
                        Número de páginas *
                        <input
                            class="form-control"
                            type="number"
                            @bind="Borrador.Paginas"
                            @bind:event="oninput"
                            min="1"
                            required
                        />
                    </label>
                    <label class="field form-label d-block mb-3 col-md-6">
                        Peso (kg)
                        <input class="form-control" @bind="Peso" @bind:event="oninput" />
                    </label>
                    <label class="field form-label d-block mb-3 col-md-6">
                        Alto (cm)
                        <input class="form-control" @bind="Alto" @bind:event="oninput" />
                    </label>
                    <label class="field form-label d-block mb-3 col-md-6">
                        Ancho (cm)
                        <input class="form-control" @bind="Ancho" @bind:event="oninput" />
                    </label>
                    <label class="field form-label d-block mb-3 col-md-6">
                        Saga
                        <input class="form-control" @bind="Borrador.Saga" @bind:event="oninput" />
                    </label>
                    <label class="field form-label d-block mb-3 col-md-6">
                        Tomo
                        <input
                            class="form-control"
                            type="number"
                            min="1"
                            @bind="Borrador.Tomo"
                            @bind:event="oninput"
                        />
                    </label>
                </div>
            }
            else if (Pestana == "Precio")
            {
                <div class="price-editor my-4">
                    <p class="text-body-secondary">Precio base del libro</p>
                    <label class="field form-label d-block mb-3">
                        Precio base (S/) *
                        <input class="form-control"
                            type="number"
                            step="0.01"
                            min="0.01"
                            @bind="Borrador.PrecioOriginal"
                            @bind:event="oninput"
                            required
                            />
                    </label>
                </div>
            }
            else if (Pestana == "Stock")
            {
                <div class="price-editor my-4">
                    <p class="text-body-secondary">Ejemplares disponibles</p>
                    <label class="field form-label d-block mb-3">
                        Stock *
                        <input
                            class="form-control"
                            type="number"
                            min="0"
                            @bind="Borrador.Stock"
                            @bind:event="oninput"
                            required
                        />
                    </label>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-end my-4">
                    <button type="button" class="btn btn-secondary" @onclick="AgregarDescuento">
                        <Icono Nombre="plus" />
                        Añadir descuento
                    </button>
                </div>
                @if (Descuentos.Count > 0)
                {
                    <div class="d-flex align-items-center gap-3">
                        <button
                            type="button"
                            class="btn btn-outline-secondary icon-button"
                            disabled="@(PosicionDescuentos == 0)"
                            aria-label="Descuentos anteriores"
                            @onclick="DescuentoAnterior">
                            ‹
                        </button>
                        <div class="row row-cols-1 row-cols-md-2 g-3 flex-grow-1">
                            @foreach (var Descuento in Descuentos.Skip(PosicionDescuentos).Take(2))
                            {
                                <div class="col">
                                    <button
                                        type="button"
                                        class="card discount-card h-100 w-100 text-start gap-3 p-3
                                            @(DescuentoSeleccionado == Descuento ? "selected border-2" : "")"
                                        @onclick="() => ElegirDescuento(Descuento)">
                                        <span class="discount-percentage">
                                            @Descuento.Porcentaje%
                                            <small class="d-block">de descuento</small>
                                        </span>
                                        <span class="text-body-secondary">
                                            Inicio: @Descuento.Inicio.ToString("dd/MM/yyyy, HH:mm")
                                            <br />
                                            Fin: @Descuento.Fin.ToString("dd/MM/yyyy, HH:mm")
                                        </span>
                                    </button>
                                </div>
                            }
                        </div>
                        <button
                            type="button"
                            class="btn btn-outline-secondary icon-button"
                            disabled="@(PosicionDescuentos + 2 >= Descuentos.Count)"
                            aria-label="Descuentos siguientes"
                            @onclick="DescuentoSiguiente">
                            ›
                        </button>
                    </div>
                    <p class="text-center text-body-secondary small mt-3 mb-4">
                        @(PosicionDescuentos + 1) – @Math.Min(PosicionDescuentos + 2, Descuentos.Count) de
                        @Descuentos.Count
                    </p>
                }
                @if (DescuentoSeleccionado is not null)
                {
                    <h3>Editar descuento</h3>
                    <div class="row g-3">
                        <label class="field form-label d-block mb-3 col-md-4">
                            Porcentaje *
                            <input class="form-control"
                                type="number"
                                min="1"
                                max="100"
                                @bind="Porcentaje"
                                @bind:event="oninput"
                                required
                                />
                        </label>
                        <label class="field form-label d-block mb-3 col-md-4">
                            Fecha y hora de inicio *
                            <input class="form-control"
                                type="datetime-local"
                                @bind="InicioDescuento"
                                @bind:format="yyyy-MM-ddTHH:mm"
                                required
                                />
                        </label>
                        <label class="field form-label d-block mb-3 col-md-4">
                            Fecha y hora de fin *
                            <input class="form-control"
                                type="datetime-local"
                                @bind="FinDescuento"
                                @bind:format="yyyy-MM-ddTHH:mm"
                                required
                                />
                        </label>
                    </div>
                    <label class="form-check form-check-label my-4 text-danger">
                        <input class="form-check-input" type="checkbox" @bind="EliminarDescuento" />
                        Eliminar descuento
                    </label>
                }
                else
                {
                    <div class="empty-state d-flex flex-column align-items-center justify-content-center">
                        <Icono Nombre="report" />
                        <p>Este libro no tiene descuentos.</p>
                        <span>Añade uno para completar la vista de gestión.</span>
                    </div>
                }
            }
            @if (ErrorFormulario.Length > 0)
            {
                <p class="alert alert-danger form-error" role="alert">@ErrorFormulario</p>
            }
            <div class="modal-footer px-0 pb-0 mt-4">
                <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                <button class="btn btn-primary" type="submit">Guardar cambios</button>
            </div>
        </form>
    </Modal>
}
