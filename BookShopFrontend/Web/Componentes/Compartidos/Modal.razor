<div class="modal-backdrop fade show"></div>
<div
    class="modal d-block bookshop-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="@IdTitulo"
    tabindex="-1"
    @onclick="Cerrar">
    <div
        class="modal-dialog modal-dialog-centered modal-dialog-scrollable @(Amplio ? "modal-lg" : "")"
        @onclick:stopPropagation>
        <section class="modal-content">
            <header class="modal-header">
                <h2 class="modal-title fs-4" id="@IdTitulo">@Titulo</h2>
                <button
                    type="button"
                    class="btn btn-link icon-button modal-close"
                    aria-label="Cerrar ventana" disabled="@Ocupado"
                    @onclick="Cerrar">
                    <Icono Nombre="close" />
                </button>
            </header>
            <div class="modal-body">@ChildContent</div>
        </section>
    </div>
</div>

@code {
    [Parameter]
    public string Titulo { get; set; } = "";

    [Parameter]
    public bool Amplio { get; set; }

    [Parameter]
    public EventCallback AlCerrar { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter] public bool Ocupado { get; set; }
    private Task Cerrar() => Ocupado ? Task.CompletedTask : AlCerrar.InvokeAsync();

    private readonly string IdTitulo = "dialog-" + Guid.NewGuid().ToString("N");
}
