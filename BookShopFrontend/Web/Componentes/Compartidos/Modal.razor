<div class="modal-backdrop fade show"></div>
<div class="modal d-block bookshop-modal" role="dialog" aria-modal="true" aria-label="@Titulo"
     tabindex="-1" @onclick="Cerrar" @onkeydown="TeclaPresionada">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable @(Amplio ? "modal-lg" : "")"
         @onclick:stopPropagation>
        <section class="modal-content">
            <header class="modal-header">
                <h2 class="modal-title fs-4">@Titulo</h2>
                <button type="button" class="btn btn-link icon-button modal-close" aria-label="Cerrar ventana"
                        disabled="@Ocupado" @onclick="Cerrar">
                    <Icono Nombre="close" />
                </button>
            </header>
            <div class="modal-body">@ChildContent</div>
        </section>
    </div>
</div>

@code {
    [Parameter]
    public string Titulo { get; set; } = "";

    [Parameter]
    public bool Amplio { get; set; }

    [Parameter]
    public bool Ocupado { get; set; }

    [Parameter]
    public EventCallback AlCerrar { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private async Task Cerrar()
    {
        if (!Ocupado)
            await AlCerrar.InvokeAsync();
    }

    // La tecla Escape cierra la ventana.
    private async Task TeclaPresionada(KeyboardEventArgs evento)
    {
        if (evento.Key == "Escape")
            await Cerrar();
    }
}
