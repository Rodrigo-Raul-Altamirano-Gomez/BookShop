@if (Estado.EsAdministrador)
{
    <div class="management-actions d-flex flex-wrap gap-2 my-3">
        <button class="btn btn-secondary" @onclick="Abrir">
            <Icono Nombre="edit" />
            Editar
        </button>
        <button class="btn btn-secondary" @onclick="AlternarActivo">
            @(Referencia.Activo ? "Desactivar" : "Activar")
        </button>
    </div>
}
@if (Mostrar)
{
    <Modal Titulo="@($"Editar {Singular}")" AlCerrar="Cerrar">
        <form @onsubmit="Guardar" @onsubmit:preventDefault>
            <label class="field form-label d-block mb-3">
                Nombre *
                <input class="form-control" @bind="Nombre" @bind:event="oninput" required />
            </label>
            <label class="field form-label d-block mb-3">
                @(Referencia.Tipo == "autores" ? "Biografía" : "Descripción") *
                <textarea class="form-control" @bind="Descripcion" @bind:event="oninput" rows="6" required>
                </textarea>
            </label>
            @if (ErrorFormulario.Length > 0)
            {
                <p class="alert alert-danger form-error" role="alert">@ErrorFormulario</p>
            }
            <div class="modal-footer px-0 pb-0 mt-4">
                <button class="btn btn-secondary" type="button" @onclick="Cerrar">Cancelar</button>
                <button class="btn btn-primary" type="submit">Guardar cambios</button>
            </div>
        </form>
    </Modal>
}
