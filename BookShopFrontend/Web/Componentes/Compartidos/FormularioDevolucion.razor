<Modal Titulo="@Titulo" AlCerrar="AlCerrar" Ocupado="@guardando">
    <form @onsubmit="Guardar" @onsubmit:preventDefault>
        <label class="form-label d-block mb-3">Motivo
            <select class="form-select" @bind="borrador.Motivo" required>
                <option value="" disabled>Selecciona un motivo</option>
                <option value="LIBRO_DANADO">Libro dañado</option>
                <option value="LIBRO_INCORRECTO">Libro incorrecto</option>
                <option value="PEDIDO_INCOMPLETO">Pedido incompleto</option>
                <option value="NO_CUMPLE_EXPECTATIVAS">No cumple las expectativas</option>
                <option value="OTRO">Otro</option>
            </select>
        </label>
        <label class="form-label d-block mb-3">Comentario adicional
            <textarea class="form-control" rows="4" @bind="borrador.Comentario"></textarea>
        </label>
        @if (error is not null)
        {
            <p class="alert alert-danger" role="alert">@error</p>
        }
        <div class="modal-footer px-0 pb-0">
            <button class="btn btn-secondary" type="button" @onclick="AlCerrar" disabled="@guardando">Cancelar</button>
            <button class="btn btn-primary" type="submit" disabled="@guardando">Guardar solicitud</button>
        </div>
    </form>
</Modal>

@code {
    [Parameter] public string Titulo { get; set; } = "Solicitar devolución";
    [Parameter] public DatosDevolucionDTO? Valor { get; set; }
    [Parameter] public EventCallback<DatosDevolucionDTO> AlGuardar { get; set; }
    [Parameter] public EventCallback AlCerrar { get; set; }
    private DatosDevolucionDTO borrador = new();
    private bool guardando;
    private string? error;

    protected override void OnInitialized()
    {
        if (Valor is not null)
            borrador = new DatosDevolucionDTO { Motivo = Valor.Motivo, Comentario = Valor.Comentario };
    }

    private async Task Guardar()
    {
        guardando = true;
        error = null;
        try
        {
            await AlGuardar.InvokeAsync(borrador);
        }
        catch (InvalidOperationException e)
        {
            error = e.Message;
        }
        guardando = false;
    }
}
