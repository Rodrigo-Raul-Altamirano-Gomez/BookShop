<?xml version="1.0" encoding="UTF-8"?>
<!-- RF18 · Libros por monto vendido (UX-UI §11.2), A4 horizontal. JasperReports 7.0.6.
     Se edita en Jaspersoft Studio 7 y se compila a reporte-libros.jasper, que es el que carga ReporteBLImpl.
     Filas: un mapa por libro (titulo, categoria, autor, editorial, cantidad, monto), ya ordenadas por monto. -->
<jasperReport name="reporte-libros" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762" leftMargin="40" rightMargin="40" topMargin="36" bottomMargin="30" whenNoDataType="AllSectionsNoDetail" uuid="5b2c7f10-1d3e-4a8b-9c11-7e6f5a4b3c01">
	<property name="net.sf.jasperreports.export.pdf.metadata.title" value="Libros por monto vendido · BookShop"/>
	<style name="Normal" default="true" forecolor="#1E1A16" fontName="Public Sans" fontSize="9.0"/>
	<style name="Muted" style="Normal" forecolor="#6E655B"/>
	<style name="Caption" style="Normal" forecolor="#6E655B" fontSize="7.5" bold="true"/>
	<style name="Titulo" style="Normal" fontName="Newsreader" fontSize="18.0"/>
	<parameter name="periodo" class="java.lang.String"/>
	<parameter name="generado" class="java.lang.String"/>
	<parameter name="resultados" class="java.lang.Integer"/>
	<field name="titulo" class="java.lang.String"/>
	<field name="categoria" class="java.lang.String"/>
	<field name="autor" class="java.lang.String"/>
	<field name="editorial" class="java.lang.String"/>
	<field name="cantidad" class="java.lang.Integer"/>
	<field name="monto" class="java.lang.Double"/>
	<variable name="totalCantidad" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA[$F{cantidad}]]></expression>
	</variable>
	<variable name="totalMonto" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{monto}]]></expression>
	</variable>
