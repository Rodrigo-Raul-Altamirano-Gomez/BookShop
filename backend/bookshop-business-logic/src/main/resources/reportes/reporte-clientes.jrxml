	<field name="autor" class="java.lang.String"/>
	<field name="editorial" class="java.lang.String"/>
	<variable name="totalGasto" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{gasto}]]></expression>
	</variable>
