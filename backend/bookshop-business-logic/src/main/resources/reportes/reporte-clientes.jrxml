	<style name="Muted" style="Normal" forecolor="#6E655B"/>
	<style name="Caption" style="Normal" forecolor="#6E655B" fontSize="7.5" bold="true"/>
	<style name="Titulo" style="Normal" fontName="Newsreader" fontSize="18.0"/>
	<parameter name="periodo" class="java.lang.String"/>
	<parameter name="generado" class="java.lang.String"/>
	<parameter name="resultados" class="java.lang.Integer"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="correo" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
