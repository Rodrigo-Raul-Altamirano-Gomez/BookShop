<?xml version="1.0" encoding="UTF-8"?>
<!-- RF19 · Clientes por monto gastado (UX-UI §11.3), A4 horizontal. JasperReports 7.0.6.
     Se edita en Jaspersoft Studio 7 y se compila a reporte-clientes.jasper, que es el que carga ReporteBLImpl.
     Filas: un mapa por cliente (nombre, correo, estado, diasUso, gasto, categoria, autor, editorial), ya ordenadas por gasto. -->
<jasperReport name="reporte-clientes" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762" leftMargin="40" rightMargin="40" topMargin="36" bottomMargin="30" whenNoDataType="AllSectionsNoDetail" uuid="7d4e9a20-3f5a-4c6d-8e22-9a8b7c6d5e01">
	<property name="net.sf.jasperreports.export.pdf.metadata.title" value="Clientes por monto gastado · BookShop"/>
